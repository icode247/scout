# Public Supabase project values (safe to expose; RLS protects data)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only: required for permanent account deletion. Never prefix with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Canonical production URL used for auth redirects and SEO
PUBLIC_SITE_URL=https://your-scout-domain.com
PUBLIC_CHROME_EXTENSION_ID=abcdefghijklmnopqrstuvwxyzabcdef

# Development only. Never enable this on production.
SCOUT_DEMO_MODE=false

# Optional analytics
PUBLIC_PLAUSIBLE_DOMAIN=

# Google Analytics 4. Measurement ID is public; API secret is server-only and
# enables trusted payment, renewal, failure, cancellation, and churn events.
PUBLIC_GA_MEASUREMENT_ID=G-V0WVY23KGK
GA_API_SECRET=

# Bing Webmaster Tools HTML meta verification value (msvalidate.01).
PUBLIC_BING_SITE_VERIFICATION=

# PostHog analytics (client-side public key + server-side key)
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_REPLACE_ME
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=phc_REPLACE_ME
POSTHOG_HOST=https://us.i.posthog.com

# Optional production integrations
PUBLIC_CHROME_EXTENSION_URL=
RESUME_EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ADMIN_EMAILS=
FULFILLMENT_API_KEY=

# Booking: the Calendly event the /book-call page embeds in step 2.
# Without this the page falls back to a hardcoded URL.
PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/scout-strategy-call

# Dodo Payments. Run `npm run dodo:setup` to create the products and print the
# ten product ids below. Keep DODO_ENVIRONMENT on test_mode until you have run
# a full test purchase; switching to live_mode charges real cards.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode
# The Dodo brand the products belong to — it sets the logo on the checkout page,
# the support email, and the descriptor on the buyer's card statement. Only the
# setup script reads these. Name is matched case-insensitively; DODO_BRAND_ID
# overrides it. One Dodo account can hold several brands, so if this account
# also sells something else, be explicit.
# Quoted because the value contains a space — Node's env parser copes either
# way, but anything that `source`s this file would read "AI" as a command.
DODO_BRAND_NAME="Scout AI"
DODO_BRAND_ID=
DODO_PRODUCT_HUMAN_FOCUSED=
DODO_PRODUCT_HUMAN_FULL=
DODO_PRODUCT_HUMAN_CAMPAIGN=
DODO_PRODUCT_AI_ESSENTIAL=
DODO_PRODUCT_AI_PLUS=
# Prepaid 90-day term, ~10% cheaper. AI bills every 3 months; Human bundles
# keep the same allowance but expire 90 days after purchase.
DODO_PRODUCT_HUMAN_FOCUSED_90=
DODO_PRODUCT_HUMAN_FULL_90=
DODO_PRODUCT_HUMAN_CAMPAIGN_90=
DODO_PRODUCT_AI_ESSENTIAL_90=
DODO_PRODUCT_AI_PLUS_90=

# Resend transactional email (subscription confirmation after payment). Until
# the key is set, the webhook logs a warning and skips the email — billing is
# unaffected. The From address must be on a domain verified in Resend
# (updates.applyscout.app); it defaults to
# "Kate from Scout <kate@updates.applyscout.app>" when RESEND_FROM_EMAIL is
# empty. Replies go to kate@applyscout.app by default.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Kate from Scout <kate@updates.applyscout.app>"
RESEND_REPLY_TO="kate@applyscout.app"
# Required for marketing/lifecycle email footers. Launch sends fail closed when
# this is empty so a placeholder address can never reach customers.
SCOUT_MAILING_ADDRESS="Scout, Ikeja, Lagos 100001, Nigeria"

# Server-only FastApply integration
FIRSTAPPLY_API_URL=https://api.fastapply.co
FIRSTAPPLY_API_TOKEN=

# Server-only job board integration
BOARD_API_URL=https://job-aggregator-web-gt9m.onrender.com/api/jobs
BOARD_API_TOKEN=

# Server-only: shared secret for the scheduled reconciliation/scoring cron
# (/api/cron/reconcile). Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=
