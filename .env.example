# Public Supabase project values (safe to expose; RLS protects data)
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME

# Server-only: required for permanent account deletion. Never prefix with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=REPLACE_ME

# Canonical production URL used for auth redirects and SEO
PUBLIC_SITE_URL=https://your-scout-domain.com
PUBLIC_CHROME_EXTENSION_ID=abcdefghijklmnopqrstuvwxyzabcdef

# Development only. Never enable this on production.
SCOUT_DEMO_MODE=false

# Optional analytics
PUBLIC_PLAUSIBLE_DOMAIN=

# PostHog analytics (client-side public key + server-side key)
PUBLIC_POSTHOG_PROJECT_TOKEN=phc_REPLACE_ME
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_PROJECT_TOKEN=phc_REPLACE_ME
POSTHOG_HOST=https://us.i.posthog.com

# Optional production integrations
PUBLIC_CHROME_EXTENSION_URL=
RESUME_EXTRACTION_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ADMIN_EMAILS=
FULFILLMENT_API_KEY=

# Booking: the Calendly event the /book-call page embeds in step 2.
# Without this the page falls back to a hardcoded URL.
PUBLIC_CALENDLY_URL=https://calendly.com/your-handle/scout-strategy-call

# Dodo Payments. Run `npm run dodo:setup` to create the products and print the
# five product ids below. Keep DODO_ENVIRONMENT on test_mode until you have run
# a full test purchase; switching to live_mode charges real cards.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode
DODO_PRODUCT_HUMAN_FOCUSED=
DODO_PRODUCT_HUMAN_FULL=
DODO_PRODUCT_HUMAN_CAMPAIGN=
DODO_PRODUCT_AI_ESSENTIAL=
DODO_PRODUCT_AI_PLUS=

# Server-only FastApply integration
FIRSTAPPLY_API_URL=https://api.fastapply.co
FIRSTAPPLY_API_TOKEN=

# Server-only job board integration
BOARD_API_URL=https://fastapply-board-4ea516473ba2.herokuapp.com/api/jobs
BOARD_API_TOKEN=

# Server-only: shared secret for the scheduled reconciliation/scoring cron
# (/api/cron/reconcile). Vercel Cron sends this as `Authorization: Bearer <CRON_SECRET>`.
# Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=
