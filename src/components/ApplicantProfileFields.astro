---
/**
 * The job profile's application answers inside the /profiles dialog. The editor is a React
 * island (profile/ApplicantProfileEditor.tsx); this host element is what pages/profiles.astro
 * talks to (see the contract in that file), and it exists before the island hydrates.
 */
import ApplicantProfileEditor from "./profile/ApplicantProfileEditor";

interface Props { demo?: boolean }
const { demo = false } = Astro.props;
---
<!-- min-w-0: a grid item otherwise grows to its content's widest line and pushes the dialog sideways on a phone. -->
<div class="min-w-0 sm:col-span-2" data-applicant-editor>
  <!-- Shown by pages/profiles.astro when the editor never starts (a script failed to load). -->
  <p data-editor-fallback class="hidden rounded-xl bg-amber-50 p-4 text-sm font-bold text-amber-900" role="alert">
    Your application answers could not load. Reload the page to edit them. Saving now leaves them as they are.
  </p>
  <ApplicantProfileEditor client:load demo={demo} />
</div>
