---
/**
 * Guided plan finder for the pricing page: three questions on the left, one
 * recommended plan on the right. The recommendation, its prices and the
 * "more for the same price" figures all come from the plan catalog, so nothing
 * here can state a price or a saving that is not real.
 *
 * It renders a real recommendation on the server (AI, one role, 100 a month),
 * so the section is complete without JavaScript; the script only re-picks the
 * plan as the answers change.
 */
import TermSwitcher from "./TermSwitcher.astro";
import { PLANS, allowanceBoost, formatRegionalAmount, regionalPriceLabel, savings, savingsLabel, type Plan, type RegionCode } from "../config/plans";

interface Props {
  region: RegionCode | null;
  signedIn: boolean;
}
const { region, signedIn } = Astro.props;

const DEFAULTS = { lane: "ai", roles: 1, apps: 100 } as const;
const DOTS = 24;

const priceOf = (plan: Plan) => (region ? regionalPriceLabel(plan, region) : plan.priceLabel);
const threeMonths = (plan: Plan) => {
  const monthly = PLANS.find((other) => other.family === plan.family && other.term === "standard")!;
  return region ? formatRegionalAmount(region, monthly.regional[region] * 3) : `$${Math.round((monthly.priceCents * 3) / 100).toLocaleString("en-US")}`;
};

const view = (plan: Plan) => {
  const price = priceOf(plan);
  const prepaid = savings(plan);
  const boost = allowanceBoost(plan, region);
  return {
    code: plan.code,
    lane: plan.lane,
    term: plan.term,
    name: plan.name,
    blurb: plan.blurb,
    // The price is always the real price. The only struck-through price is
    // three monthly payments beside a 90-day plan, which is what it replaces.
    now: price,
    was: prepaid ? threeMonths(plan) : "",
    note: plan.cadenceLabel,
    badge: prepaid ? `−${prepaid.percent}% · ${savingsLabel(plan, region)}` : "",
    // Shown only for plans whose allowance was raised at the same price.
    headline: boost ? boost.headline : "",
    each: boost ? boost.perApplication : "",
    prevEach: boost ? boost.previousPerApplication : "",
    monthlyQuota: Math.round(plan.applicationsQuota / Math.max(1, plan.billingMonths)),
    applications: plan.applications,
    profileLimit: plan.profileLimit,
    features: plan.features,
  };
};
const plans = PLANS.map(view);
type View = (typeof plans)[number];

const pick = (lane: string, term: string, roles: number, apps: number): View => {
  const list = plans.filter((plan) => plan.lane === lane && plan.term === term).sort((a, b) => a.monthlyQuota - b.monthlyQuota);
  return list.find((plan) => plan.monthlyQuota >= apps && plan.profileLimit >= roles) ?? list[list.length - 1];
};
const first = pick(DEFAULTS.lane, "standard", DEFAULTS.roles, DEFAULTS.apps);
const perWeek = (apps: number) => Math.round((apps * 12) / 52);
const filled = (apps: number, quota: number) => Math.max(1, Math.round((Math.min(apps, quota) / quota) * DOTS));

const lanes = [
  { value: "ai", title: "AI Assistant", detail: "Software applies for you. Starts the day you pay." },
  { value: "human", title: "Human Assistant", detail: "A dedicated person applies for you, with a WhatsApp group." },
];
const roleOptions = [
  { value: 1, title: "One kind of role" },
  { value: 2, title: "Two kinds" },
  { value: 3, title: "Three or more" },
];
const choice = "block h-full cursor-pointer rounded-2xl border border-white/15 bg-white/5 p-4 transition hover:border-white/40 peer-checked:border-brand-300 peer-checked:bg-brand-300/10 peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand-300";
---
<section id="plan-finder" class="bg-brand-950 py-14 text-white sm:py-20" data-default-lane={DEFAULTS.lane}>
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <div class="max-w-3xl">
      <h1 class="font-display text-4xl font-extrabold leading-[1.02] tracking-[-0.03em] text-white sm:text-6xl">Find the plan for your job search</h1>
      <p class="mt-4 text-lg leading-relaxed text-white/70">Answer three questions and see the plan that fits, with what it costs today. No call needed.</p>
    </div>

    <div class="mt-10 grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-start">
      <form class="space-y-9" data-pf-form onsubmit="return false">
        <fieldset>
          <legend class="flex items-center gap-3 text-xl font-extrabold text-white"><span class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-sm">1</span>Who should send your applications?</legend>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            {lanes.map((lane) => (
              <label class="relative">
                <input type="radio" name="pf-lane" value={lane.value} checked={lane.value === DEFAULTS.lane} class="peer sr-only" />
                <span class={choice}>
                  <span class="block font-extrabold text-white">{lane.title}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-white/65">{lane.detail}</span>
                </span>
              </label>
            ))}
          </div>
        </fieldset>

        <fieldset>
          <legend class="flex items-center gap-3 text-xl font-extrabold text-white"><span class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-sm">2</span>How many kinds of role are you going for?</legend>
          <p class="mt-2 text-sm text-white/55">Each kind of role gets its own job profile and resume.</p>
          <div class="mt-4 grid gap-3 sm:grid-cols-3">
            {roleOptions.map((option) => (
              <label class="relative">
                <input type="radio" name="pf-roles" value={option.value} checked={option.value === DEFAULTS.roles} class="peer sr-only" />
                <span class={`${choice} font-extrabold text-white`}>{option.title}</span>
              </label>
            ))}
          </div>
        </fieldset>

        <div>
          <label for="pf-apps" class="flex items-center gap-3 text-xl font-extrabold text-white"><span class="grid h-9 w-9 place-items-center rounded-full bg-white/10 text-sm">3</span>How many applications a month?</label>
          <div class="mt-4 rounded-2xl border border-white/15 bg-white/5 p-5">
            <input id="pf-apps" type="range" name="pf-apps" min="25" max="1000" step="25" value={DEFAULTS.apps} class="pf-range w-full" aria-describedby="pf-apps-output" />
            <div class="mt-1 flex justify-between text-xs font-semibold text-white/40" aria-hidden="true"><span>25</span><span>250</span><span>500</span><span>750</span><span>1,000</span></div>
            <p id="pf-apps-output" class="mt-4 font-extrabold text-white"><span data-pf="apps">{DEFAULTS.apps}</span> applications a month <span class="font-semibold text-white/55">· about <span data-pf="week">{perWeek(DEFAULTS.apps)}</span> a week</span></p>
            <p class="mt-1 text-sm leading-relaxed text-white/60">Every week you put this off is about <span data-pf="week">{perWeek(DEFAULTS.apps)}</span> applications that do not go out.</p>
          </div>
        </div>
      </form>

      <div class="lg:sticky lg:top-24" data-pf-card aria-live="polite">
        <div class="flex justify-center"><TermSwitcher tone="light" /></div>

        <div class="mt-5 overflow-hidden rounded-2xl bg-white/5 ring-1 ring-white/15">
          <div class="bg-gradient-to-b from-brand-300 to-brand-500 p-6 text-brand-950 sm:p-7">
            <p class="text-xs font-black uppercase tracking-[0.12em] text-brand-900">Recommended for you</p>
            <div class="mt-2 flex flex-wrap items-center gap-3">
              <h2 class="font-display text-4xl font-extrabold text-brand-950" data-pf="name">{first.name}</h2>
              <span class="rounded-full bg-brand-950/15 px-3 py-1 text-sm font-extrabold" data-pf="applications">{first.applications}</span>
            </div>
            <p class="mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <s class={`font-display text-3xl font-bold text-brand-950/50 ${first.was ? "" : "hidden"}`} data-pf="was">{first.was}</s>
              <span class="font-display text-5xl font-extrabold" data-pf="now">{first.now}</span>
              <span class="text-sm font-bold text-brand-950/75" data-pf="note">{first.note}</span>
            </p>
            <p class={`mt-3 w-fit rounded-xl bg-brand-950 px-3 py-2 text-sm font-bold leading-snug text-white ${first.headline ? "" : "hidden"}`} data-pf-boost>
              <span class="text-brand-300" data-pf="headline">{first.headline}</span>, same price · <s class="text-white/50" data-pf="prevEach">{first.prevEach}</s> <span data-pf="each">{first.each}</span> per application
            </p>
            {signedIn
              ? <button type="button" data-checkout-plan={first.code} data-pf-cta class="mt-5 flex min-h-14 w-full flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-[28px] bg-white px-5 py-2.5 text-lg font-extrabold text-brand-950 shadow-sm transition hover:bg-brand-50 disabled:opacity-60"><span class="whitespace-nowrap">Get <span data-pf="name">{first.name}</span></span><span class={`whitespace-nowrap rounded-full bg-human-500 px-2.5 py-1 text-xs font-black text-white ${first.badge ? "" : "hidden"}`} data-pf="badge">{first.badge}</span></button>
              : <a href={`/checkout/start?plan=${first.code}`} data-pf-cta class="mt-5 flex min-h-14 w-full flex-wrap items-center justify-center gap-x-3 gap-y-1 rounded-[28px] bg-white px-5 py-2.5 text-lg font-extrabold text-brand-950 shadow-sm transition hover:bg-brand-50"><span class="whitespace-nowrap">Get <span data-pf="name">{first.name}</span></span><span class={`whitespace-nowrap rounded-full bg-human-500 px-2.5 py-1 text-xs font-black text-white ${first.badge ? "" : "hidden"}`} data-pf="badge">{first.badge}</span></a>}
            <p class="mt-3 text-center text-xs font-semibold text-brand-950/65">Cancel anytime. No placement fee and no cut of your salary.</p>
          </div>

          <div class="p-6 sm:p-7">
            <div class="flex items-center justify-between gap-4">
              <div>
                <p class="text-sm font-semibold text-white/55">Your expected monthly usage</p>
                <p class="mt-1 font-extrabold text-white"><span data-pf="used">{Math.min(DEFAULTS.apps, first.monthlyQuota)}</span> of <span data-pf="quota">{first.monthlyQuota}</span> applications</p>
              </div>
              <div class="grid shrink-0 grid-cols-8 gap-1" data-pf="dots" aria-hidden="true">
                {Array.from({ length: DOTS }, (_, index) => <span class={`h-2 w-2 rounded-[2px] ${index < filled(DEFAULTS.apps, first.monthlyQuota) ? "bg-brand-300" : "bg-white/15"}`}></span>)}
              </div>
            </div>
            <p class="mt-3 hidden rounded-xl bg-white/10 p-3 text-sm leading-relaxed text-white/80" data-pf="over"></p>

            <p class="mt-6 border-t border-white/10 pt-5 text-sm font-semibold text-white/55">Included in the plan</p>
            <ul class="mt-3 space-y-2.5 text-sm font-semibold text-white/85" data-pf="features">
              {first.features.map((feature) => <li class="flex gap-2"><span class="text-brand-300">✓</span>{feature}</li>)}
            </ul>
            <p class="mt-6 text-sm text-white/55">Want to compare them all? <a href="#ai" class="font-extrabold text-brand-300 hover:text-brand-200">AI plans</a> · <a href="#human" class="font-extrabold text-brand-300 hover:text-brand-200">Human plans</a></p>
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Follows the visitor down the page once the recommendation scrolls away. */}
  <div class="pointer-events-none fixed inset-x-0 bottom-0 z-40 translate-y-full opacity-0 transition duration-200 motion-reduce:transition-none" data-pf-bar>
    <div class="pointer-events-auto mx-auto flex max-w-4xl items-center justify-between gap-4 rounded-t-2xl bg-brand-950 px-5 py-3 text-white shadow-lift ring-1 ring-white/15 sm:px-6">
      <p class="min-w-0 text-sm font-bold leading-snug text-white">
        <span data-pf="name">{first.name}</span> · <span data-pf="now">{first.now}</span> <span class="font-semibold text-white/60" data-pf="note">{first.note}</span>
        <span class={`block text-brand-300 sm:ml-1 sm:inline ${first.headline ? "" : "hidden"}`} data-pf-boost><span data-pf="headline">{first.headline}</span>, same price</span>
      </p>
      {signedIn
        ? <button type="button" data-checkout-plan={first.code} data-pf-cta class="inline-flex min-h-11 shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-brand-300 px-6 font-extrabold text-brand-950 transition hover:bg-brand-200 disabled:opacity-60">Get started</button>
        : <a href={`/checkout/start?plan=${first.code}`} data-pf-cta class="inline-flex min-h-11 shrink-0 items-center justify-center whitespace-nowrap rounded-full bg-brand-300 px-6 font-extrabold text-brand-950 transition hover:bg-brand-200">Get started</a>}
    </div>
  </div>

  <script type="application/json" id="plan-finder-data" set:html={JSON.stringify({ plans, dots: DOTS })} />
</section>

<style>
  .pf-range { accent-color: #b4ef6f; height: 2rem; cursor: pointer; }
</style>

<script is:inline>
  (function () {
    var root = document.getElementById("plan-finder");
    var source = document.getElementById("plan-finder-data");
    if (!root || !source) return;
    var data = JSON.parse(source.textContent);
    var form = root.querySelector("[data-pf-form]");
    var range = root.querySelector("#pf-apps");
    var LANE_NAMES = { ai: "AI Assistant", human: "Human Assistant" };

    function term() { return document.documentElement.getAttribute("data-term") === "quarterly" ? "quarterly" : "standard"; }
    function answers() {
      return {
        lane: (form.querySelector('input[name="pf-lane"]:checked') || {}).value || "ai",
        roles: Number((form.querySelector('input[name="pf-roles"]:checked') || {}).value || 1),
        apps: Number(range.value) || 100,
      };
    }
    function pick(state) {
      var list = data.plans.filter(function (plan) { return plan.lane === state.lane && plan.term === term(); })
        .sort(function (a, b) { return a.monthlyQuota - b.monthlyQuota; });
      return list.filter(function (plan) { return plan.monthlyQuota >= state.apps && plan.profileLimit >= state.roles; })[0] || list[list.length - 1];
    }
    function setAll(key, value) {
      root.querySelectorAll('[data-pf="' + key + '"]').forEach(function (node) {
        node.textContent = value;
        if (key === "was" || key === "badge") node.classList.toggle("hidden", !value);
      });
    }

    var tracked = null;
    function render(announce) {
      var state = answers();
      var plan = pick(state);
      if (!plan) return;
      var used = Math.min(state.apps, plan.monthlyQuota);
      var week = Math.round((state.apps * 12) / 52);
      ["name", "applications", "was", "now", "note", "badge", "headline", "each", "prevEach"].forEach(function (key) { setAll(key, plan[key]); });
      setAll("apps", state.apps.toLocaleString("en-US"));
      setAll("week", String(week));
      setAll("used", used.toLocaleString("en-US"));
      setAll("quota", plan.monthlyQuota.toLocaleString("en-US"));

      root.querySelectorAll("[data-pf-boost]").forEach(function (node) { node.classList.toggle("hidden", !plan.headline); });

      var lit = Math.max(1, Math.round((used / plan.monthlyQuota) * data.dots));
      root.querySelectorAll('[data-pf="dots"] span').forEach(function (dot, index) {
        dot.className = "h-2 w-2 rounded-[2px] " + (index < lit ? "bg-brand-300" : "bg-white/15");
      });

      var over = root.querySelector('[data-pf="over"]');
      if (state.apps > plan.monthlyQuota) {
        over.textContent = plan.name + " is the largest " + LANE_NAMES[plan.lane] + " plan and covers " + plan.monthlyQuota.toLocaleString("en-US") + " applications a month."
          + (plan.lane === "ai" ? " For more than that, choose a Human Assistant in question 1." : "");
        over.classList.remove("hidden");
      } else over.classList.add("hidden");

      var features = root.querySelector('[data-pf="features"]');
      features.textContent = "";
      plan.features.forEach(function (feature) {
        var item = document.createElement("li"), tick = document.createElement("span");
        item.className = "flex gap-2"; tick.className = "text-brand-300"; tick.textContent = "✓";
        item.appendChild(tick); item.appendChild(document.createTextNode(feature));
        features.appendChild(item);
      });

      root.querySelectorAll("[data-pf-cta]").forEach(function (cta) {
        if (cta.tagName === "A") cta.setAttribute("href", "/checkout/start?plan=" + plan.code);
        else cta.setAttribute("data-checkout-plan", plan.code);
      });

      if (announce && window.scoutTrack) {
        clearTimeout(tracked);
        tracked = setTimeout(function () {
          window.scoutTrack("Plan Finder Changed", { lane: state.lane, roles: state.roles, applications: state.apps, term: plan.term, plan_code: plan.code });
        }, 800);
      }
    }

    form.addEventListener("input", function () { render(true); });
    form.addEventListener("change", function () { render(true); });
    new MutationObserver(function () { render(false); }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-term"] });
    root.querySelectorAll("[data-pf-cta]").forEach(function (cta) {
      cta.addEventListener("click", function () {
        if (window.scoutTrack) window.scoutTrack("Plan Finder CTA Clicked", { plan_code: cta.getAttribute("data-checkout-plan") || (cta.getAttribute("href") || "").split("plan=")[1] || "", placement: cta.closest("[data-pf-bar]") ? "sticky_bar" : "card" });
      });
    });
    render(false);

    // The bar appears only after the recommendation card has scrolled out of view.
    var bar = root.querySelector("[data-pf-bar]"), card = root.querySelector("[data-pf-card]");
    if (bar && card && "IntersectionObserver" in window) {
      new IntersectionObserver(function (entries) {
        var away = !entries[0].isIntersecting && entries[0].boundingClientRect.top < 0;
        bar.classList.toggle("translate-y-full", !away);
        bar.classList.toggle("opacity-0", !away);
      }).observe(card);
    }
  })();
</script>
