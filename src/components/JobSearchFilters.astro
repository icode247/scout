---
import LocationMultiSelect from "./LocationMultiSelect.astro";
const { profiles = [] } = Astro.props;
---
<div class="search-filter-trigger"><label class="sr-only" for="active-search-filter">Saved search</label><select id="active-search-filter" class="saved-search-select"><option>Loading searches…</option></select><button id="open-search-filters" type="button" class="edit-search-button"><svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 20h9"/><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"/></svg><span>Edit search</span></button></div>
<dialog id="search-filter-dialog" class="search-filter-dialog">
<form id="search-filter-form" class="search-filter-form">
<header class="filter-dialog-header"><div><h2>Job search filters</h2><p>Create a focused search, save it, and switch whenever you need.</p></div><button type="button" data-close-filter class="filter-close" aria-label="Close search filters"><svg aria-hidden="true" viewBox="0 0 24 24"><path d="m6 6 12 12M18 6 6 18"/></svg></button></header>
<div class="filter-dialog-actions"><p><strong>Edit the selected search</strong><span> or start with a clean set of filters.</span></p><button id="new-search-filter" type="button" class="new-search-button"><span aria-hidden="true">+</span> New search</button></div><input type="hidden" name="filterId"/><div class="filter-fields"><label class="text-sm font-bold sm:col-span-2">Search name<input name="name" required placeholder="Remote product roles" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label><label class="text-sm font-bold sm:col-span-2">Job profile<select name="jobProfileId" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3">{profiles.map((profile:any)=><option value={profile.id}>{profile.name}</option>)}</select></label><label class="text-sm font-bold sm:col-span-2">Target job titles<input name="roles" required placeholder="Product Manager, Senior Product Manager" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label><div class="sm:col-span-2"><LocationMultiSelect/></div><label class="text-sm font-bold">Employment type<select name="employmentTypes" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 font-normal"><option value="">Any</option><option value="full-time">Full-time</option><option value="part-time">Part-time</option><option value="contractor">Contract</option><option value="temporary">Temporary</option><option value="internship">Internship</option></select></label><label class="text-sm font-bold">Work setting<select name="workModes" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 font-normal"><option value="">Any</option><option value="remote">Remote</option><option value="remote_solely">Remote only</option><option value="hybrid">Hybrid</option><option value="onsite">On-site</option></select></label><label class="text-sm font-bold">Experience level<select name="experienceLevels" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 font-normal"><option value="">Any</option><option value="entry">Entry</option><option value="mid">Mid</option><option value="senior">Senior</option><option value="lead">Lead</option></select></label><label class="text-sm font-bold">Date posted<select name="datePosted" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 font-normal"><option value="24h">Past 24 hours</option><option value="7d" selected>Past week</option><option value="30d">Past month</option><option value="6m">Past 6 months</option><option value="any">Any time</option></select></label><label class="text-sm font-bold sm:col-span-2">Companies to exclude <span class="font-normal text-ink-muted">(comma-separated)</span><input name="companyBlacklist" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label></div>
<p data-filter-message class="filter-message hidden"></p><footer class="filter-dialog-footer"><button type="button" data-close-filter class="filter-cancel">Cancel</button><button type="submit" class="filter-submit">Save and show jobs</button></footer>
</form></dialog>
<style>
.search-filter-trigger{display:flex;min-width:0;align-items:center;gap:.55rem}.saved-search-select{width:12.75rem;height:2.5rem;min-width:0;appearance:none;border:0;border-radius:.7rem;background-color:#dff7ef;background-image:linear-gradient(45deg,transparent 50%,#53604d 50%),linear-gradient(135deg,#53604d 50%,transparent 50%);background-position:calc(100% - 15px) 1.05rem,calc(100% - 11px) 1.05rem;background-repeat:no-repeat;background-size:4px 4px;padding:0 2rem 0 .9rem;color:#14210f;font-size:.8rem;font-weight:800;line-height:2.5rem}.edit-search-button{display:inline-flex;height:2.5rem;flex:none;align-items:center;gap:.35rem;white-space:nowrap;border-radius:.55rem;padding:0 .4rem;color:#53604d;font-size:.75rem;font-weight:750;line-height:1}
.search-filter-dialog{width:min(94vw,48rem);max-height:calc(100dvh - 2rem);overflow:hidden;border:0;border-radius:.75rem;background:#fff;padding:0;color:#14210f;box-shadow:0 12px 32px rgb(13 27 42/.18)}.search-filter-dialog::backdrop{background:rgb(10 18 12/.58)}.search-filter-form{max-height:calc(100dvh - 2rem);overflow-y:auto;overscroll-behavior:contain}.filter-dialog-header{position:sticky;top:0;z-index:2;display:flex;align-items:flex-start;justify-content:space-between;gap:1rem;border-bottom:1px solid rgb(20 33 15/.09);background:#fff;padding:1.35rem 1.5rem}.filter-dialog-header h2{font-size:1.15rem;font-weight:850;letter-spacing:-.015em}.filter-dialog-header p{margin-top:.25rem;color:#687166;font-size:.82rem}.filter-close{display:grid;width:2.25rem;height:2.25rem;flex:none;place-items:center;border-radius:.5rem;color:#687166}.filter-close:hover{background:#f2f5f0;color:#14210f}.filter-close svg{width:1rem;height:1rem;fill:none;stroke:currentColor;stroke-width:2}.filter-dialog-actions{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1rem 1.5rem}.filter-dialog-actions p{color:#687166;font-size:.78rem}.filter-dialog-actions strong{color:#14210f}.new-search-button{display:inline-flex;min-height:2.4rem;flex:none;align-items:center;gap:.4rem;border:1px solid rgb(20 33 15/.13);border-radius:.5rem;background:#fff;padding:.5rem .75rem;font-size:.78rem;font-weight:800}.new-search-button:hover{border-color:#158260;background:#f4fbf8}.new-search-button span{font-size:1rem}.filter-fields{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;padding:0 1.5rem 1.5rem}.filter-fields>label,.filter-fields>[data-location-picker]{color:#303b2d;font-size:.78rem;font-weight:750}.filter-fields>label.sm\:col-span-2,.filter-fields>[data-location-picker]{grid-column:1/-1}.filter-fields input:not([type=hidden]),.filter-fields select,.filter-fields [data-location-picker]>div:nth-of-type(1){min-height:2.75rem!important;margin-top:.4rem!important;border:1px solid #d7ddd4!important;border-radius:.5rem!important;background:#fff!important;font-size:.86rem!important;box-shadow:none!important;transition:border-color .16s ease,box-shadow .16s ease}.filter-fields input:not([type=hidden]),.filter-fields select{padding:.62rem .75rem!important}.filter-fields input::placeholder{color:#8b9387}.filter-fields input:focus,.filter-fields select:focus,.filter-fields [data-location-picker]>div:nth-of-type(1):focus-within{border-color:#158260!important;outline:0;box-shadow:0 0 0 3px rgb(21 130 96/.12)!important}.filter-fields [data-location-picker] p{margin-top:.35rem;color:#7b8477;font-size:.7rem}.filter-message{margin:0 1.5rem 1rem;border-radius:.5rem;padding:.7rem .8rem;font-size:.78rem;font-weight:750}.filter-dialog-footer{position:sticky;bottom:0;z-index:2;display:flex;justify-content:flex-end;gap:.65rem;border-top:1px solid rgb(20 33 15/.09);background:#fff;padding:1rem 1.5rem}.filter-cancel,.filter-submit{min-height:2.65rem;border-radius:.5rem;padding:.6rem 1rem;font-size:.8rem;font-weight:800}.filter-cancel{color:#53604d}.filter-cancel:hover{background:#f2f5f0}.filter-submit{background:#08795b;color:#fff}.filter-submit:hover{background:#056449}.filter-submit:disabled{cursor:wait;background:#9fc8bb}.saved-search-select:focus,.edit-search-button:focus-visible,.new-search-button:focus-visible,.filter-close:focus-visible,.filter-cancel:focus-visible,.filter-submit:focus-visible{outline:3px solid rgb(21 130 96/.18);outline-offset:2px}.edit-search-button svg{width:.9rem;height:.9rem}.edit-search-button:hover{color:#08795b}.edit-search-button span{border-bottom:1px solid currentColor}.saved-search-select:hover{background:#d2f1e7}@media(max-width:639px){.search-filter-trigger{width:100%}.saved-search-select{width:auto;flex:1}.search-filter-dialog{width:100vw;max-width:none;max-height:100dvh;margin:auto 0 0;border-radius:.75rem .75rem 0 0}.search-filter-form{max-height:94dvh}.filter-dialog-header,.filter-dialog-actions,.filter-dialog-footer{padding-inline:1rem}.filter-dialog-actions{align-items:flex-start;flex-direction:column}.filter-fields{grid-template-columns:1fr;padding-inline:1rem}.filter-fields>label{grid-column:1}.filter-dialog-footer>*{flex:1}.edit-search-button span{display:none}.edit-search-button{width:2.5rem;justify-content:center;border:1px solid rgb(20 33 15/.12);border-radius:.5rem;padding:.5rem}}
</style>

<script>
// @ts-nocheck
const dialog=document.querySelector("#search-filter-dialog"),form=document.querySelector("#search-filter-form"),picker=form?.querySelector("[data-location-picker]"),message=form?.querySelector("[data-filter-message]"),activeSelect=document.querySelector("#active-search-filter");let configs=[];const split=value=>String(value||"").split(",").map(item=>item.trim()).filter(Boolean);
// The jobs page keys its scroll position on `scout-job-offset:<profileId>` and
// `scout-job-relaxed:<profileId>`. Saving a search used to clear `scout-job-search:<id>`,
// a key nothing writes, so the old search's paging state outlived the search itself.
const clearJobPaging=()=>Object.keys(sessionStorage).filter(key=>key.startsWith("scout-job-")).forEach(key=>sessionStorage.removeItem(key));async function readJson(response){const type=response.headers.get("content-type")||"";if(type.includes("application/json"))return response.json();await response.text();if(response.status===401||response.redirected){location.assign("/login?next="+encodeURIComponent(location.pathname+location.search));throw new Error("Your session expired. Redirecting you to sign in…")}throw new Error("Scout could not load the search filters. Refresh and try again.")}function fill(config=configs.find(item=>item.id===activeSelect.value)){form.elements.filterId.value=config?.id||"";form.elements.name.value=config?.name||"";if(config?.job_profile_id)form.elements.jobProfileId.value=config.job_profile_id;form.elements.roles.value=(config?.roles||[]).join(", ");form.elements.employmentTypes.value=config?.employment_types?.[0]||"";form.elements.workModes.value=config?.work_modes?.[0]||"";form.elements.experienceLevels.value=config?.experience_levels?.[0]||"";form.elements.datePosted.value=config?.date_posted||"7d";form.elements.companyBlacklist.value=(config?.company_blacklist||[]).join(", ");picker?.dispatchEvent(new CustomEvent("scout:set-locations",{detail:config?.locations||[]}))}async function load(){const response=await fetch("/api/app/job-search?config=1"),data=await readJson(response);if(!response.ok)throw new Error(data.error||"Could not load filters");configs=data.configs||[];activeSelect.replaceChildren(...(configs.length?configs.map(item=>new Option(item.name,item.id,item.is_active,item.is_active)): [new Option("Create a saved search","")]));const active=configs.find(item=>item.is_active)||configs[0];if(active)activeSelect.value=active.id;fill(active)}document.querySelector("#open-search-filters")?.addEventListener("click",async()=>{dialog.showModal();document.documentElement.style.overflow="hidden";message.classList.add("hidden");try{await load()}catch(error){message.textContent=error.message;message.className="mt-4 rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700"}});dialog?.addEventListener("close",()=>document.documentElement.style.overflow="");dialog?.querySelectorAll("[data-close-filter]").forEach(button=>button.addEventListener("click",()=>dialog.close()));activeSelect?.addEventListener("change",async()=>{const filterId=activeSelect.value;if(!filterId)return;const response=await fetch("/api/app/job-search",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({action:"select",filterId})}),data=await readJson(response);if(!response.ok){window.scoutToast?.(data.error||"Could not select search",true);return}clearJobPaging();location.reload()});document.querySelector("#new-search-filter")?.addEventListener("click",()=>{form.reset();form.elements.filterId.value="";picker?.dispatchEvent(new CustomEvent("scout:set-locations",{detail:[]}));form.elements.name.focus()});form?.addEventListener("submit",async event=>{event.preventDefault();const button=event.submitter,fd=new FormData(form),locations=fd.getAll("locations");button.disabled=true;button.textContent="Saving…";try{const response=await fetch("/api/app/job-search",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({filterId:fd.get("filterId"),name:fd.get("name"),jobProfileId:fd.get("jobProfileId"),roles:split(fd.get("roles")),locations,employmentTypes:split(fd.get("employmentTypes")),workModes:split(fd.get("workModes")),experienceLevels:split(fd.get("experienceLevels")),datePosted:fd.get("datePosted"),companyBlacklist:split(fd.get("companyBlacklist"))})}),data=await readJson(response);if(!response.ok)throw new Error(data.error||"Could not save filters");clearJobPaging();location.reload()}catch(error){message.textContent=error.message;message.className="mt-4 rounded-xl bg-red-50 p-3 text-sm font-bold text-red-700";button.disabled=false;button.textContent="Save and show jobs"}});load().catch(()=>activeSelect?.replaceChildren(new Option("Search filters","")))
</script>