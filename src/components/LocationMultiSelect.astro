<div class="text-sm" data-location-picker>
  <label for="location-search" class="font-bold">Country/City</label>
  <div class="mt-2 rounded-xl border border-ink/15 bg-white px-3 py-2 focus-within:border-brand-700 focus-within:ring-2 focus-within:ring-brand-100">
    <div class="flex flex-wrap gap-2 empty:hidden" data-location-chips></div>
    <div class="flex items-center gap-2">
      <svg aria-hidden="true" class="h-4 w-4 shrink-0 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      <input id="location-search" data-location-search type="search" autocomplete="off" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="location-results" placeholder="Search a country or city" class="min-w-0 flex-1 border-0 bg-transparent px-0 py-1.5 font-normal outline-none placeholder:text-ink-muted" />
      <span class="hidden text-xs text-ink-muted" data-location-loading>Loading…</span>
    </div>
  </div>
  <p class="mt-1.5 text-xs font-normal text-ink-muted">Select one or more countries, states, cities, or Remote.</p>
  <div id="location-results" data-location-results role="listbox" class="mt-2 hidden max-h-64 overflow-y-auto rounded-xl border border-ink/10 bg-white p-1 shadow-card"></div>
  <div data-location-inputs></div>
</div>

<script>
// @ts-nocheck
// Verbatim copy of FastApply's browse-and-apply location list; see
// scripts/build-location-options.mjs. Flat strings, searched and stored exactly as
// FastApply does, so a value picked here is one the job board recognises.
const LOCATION_DATA_URL="/data/locations.json";let sharedLocationData;
const loadLocationData=async()=>{if(!sharedLocationData)sharedLocationData=fetch(LOCATION_DATA_URL).then(async response=>{if(!response.ok)throw new Error("Location data could not be loaded.");return response.json()});return sharedLocationData};
document.querySelectorAll("[data-location-picker]").forEach(picker=>{
 const search=picker.querySelector("[data-location-search]"),results=picker.querySelector("[data-location-results]"),chips=picker.querySelector("[data-location-chips]"),inputs=picker.querySelector("[data-location-inputs]"),loading=picker.querySelector("[data-location-loading]");
 let locations=[],selected=[],activeIndex=-1,visibleOptions=[],timer;
 const escapeHtml=value=>String(value).replace(/[&<>"']/g,character=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"})[character]);
 const syncSelected=()=>{chips.innerHTML=selected.map(value=>'<span class="inline-flex max-w-full items-center gap-1 rounded-full bg-brand-100 px-2.5 py-1 text-xs font-bold text-brand-950"><span class="truncate">'+escapeHtml(value)+'</span><button type="button" data-remove-location="'+escapeHtml(value)+'" class="grid h-5 w-5 shrink-0 place-items-center rounded-full hover:bg-brand-200 focus:outline-none focus:ring-2 focus:ring-brand-700" aria-label="Remove '+escapeHtml(value)+'">×</button></span>').join("");inputs.innerHTML=selected.map(value=>'<input type="hidden" name="locations" value="'+escapeHtml(value)+'">').join("")};
 const selectLocation=value=>{if(!selected.includes(value))selected.push(value);search.value="";syncSelected();renderResults("");search.focus()};
 const setActive=index=>{activeIndex=index;results.querySelectorAll("[data-location-option]").forEach((option,optionIndex)=>{option.setAttribute("aria-selected",String(optionIndex===activeIndex));option.classList.toggle("bg-brand-100",optionIndex===activeIndex)});results.querySelector('[data-location-option="'+activeIndex+'"]')?.scrollIntoView({block:"nearest"})};
 // Ranking mirrors FastApply's filterLocations: exact match first, then prefix,
 // then anything containing the query.
 const renderResults=rawQuery=>{if(!locations.length)return;const query=rawQuery.trim().toLocaleLowerCase();const rank=text=>{const normalized=text.toLocaleLowerCase();if(!query)return 1;if(normalized===query)return 0;if(normalized.startsWith(query))return 1;if(normalized.split(/[\s,./_-]+/).some(word=>word.startsWith(query)))return 2;return 3};const options=[];for(const value of locations){if(selected.includes(value))continue;if(query&&!value.toLocaleLowerCase().includes(query))continue;options.push({value,rank:rank(value)});if(!query&&options.length>=60)break}options.sort((a,b)=>a.rank-b.rank||a.value.localeCompare(b.value,"en",{sensitivity:"base"}));visibleOptions=options.slice(0,60);activeIndex=visibleOptions.length?0:-1;results.innerHTML=visibleOptions.length?visibleOptions.map((option,index)=>'<button type="button" role="option" aria-selected="'+(index===activeIndex)+'" data-location-option="'+index+'" class="flex w-full items-center gap-4 rounded-lg px-3 py-2.5 text-left hover:bg-brand-100 focus:outline-none '+(index===activeIndex?'bg-brand-100':'')+'"><span class="min-w-0 truncate font-bold">'+escapeHtml(option.value)+'</span></button>').join(""):'<p class="px-3 py-4 text-center text-sm text-ink-muted">No matching location found.</p>';results.classList.remove("hidden");search.setAttribute("aria-expanded","true")};
 const open=async()=>{if(locations.length){renderResults(search.value);return}loading.classList.remove("hidden");try{locations=await loadLocationData();renderResults(search.value)}catch{results.innerHTML='<p class="px-3 py-4 text-sm text-red-700">Locations could not be loaded. Refresh and try again.</p>';results.classList.remove("hidden");search.setAttribute("aria-expanded","true")}finally{loading.classList.add("hidden")}};
 search.addEventListener("focus",open);search.addEventListener("input",()=>{clearTimeout(timer);timer=setTimeout(()=>renderResults(search.value),120)});search.addEventListener("keydown",event=>{if(event.key==="ArrowDown"&&visibleOptions.length){event.preventDefault();setActive(Math.min(activeIndex+1,visibleOptions.length-1))}else if(event.key==="ArrowUp"&&visibleOptions.length){event.preventDefault();setActive(Math.max(activeIndex-1,0))}else if(event.key==="Enter"&&activeIndex>=0){event.preventDefault();selectLocation(visibleOptions[activeIndex].value)}else if(event.key==="Escape"){results.classList.add("hidden");search.setAttribute("aria-expanded","false")}else if(event.key==="Backspace"&&!search.value&&selected.length){selected.pop();syncSelected()}});
 results.addEventListener("mousedown",event=>event.preventDefault());results.addEventListener("click",event=>{const option=event.target.closest("[data-location-option]");if(option)selectLocation(visibleOptions[Number(option.dataset.locationOption)].value)});chips.addEventListener("click",event=>{const button=event.target.closest("[data-remove-location]");if(!button)return;selected=selected.filter(value=>value!==button.dataset.removeLocation);syncSelected();if(!results.classList.contains("hidden"))renderResults(search.value)});picker.addEventListener("scout:set-locations",event=>{selected=[...new Set((event.detail||[]).filter(Boolean))];search.value="";syncSelected();results.classList.add("hidden");search.setAttribute("aria-expanded","false")});document.addEventListener("click",event=>{if(!picker.contains(event.target)){results.classList.add("hidden");search.setAttribute("aria-expanded","false")}});syncSelected();
});
</script>
