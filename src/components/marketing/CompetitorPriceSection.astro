        <thead>
          <tr class="border-b border-ink/10">
            <th class="p-3 font-extrabold">Provider and model</th>
            <th class="p-3 font-extrabold">Published price</th>
            <th class="p-3 font-extrabold">Source and date</th>
          </tr>
        </thead>
        <tbody>
          <tr class="border-b border-ink/10">
            <td class="p-3">Scale.jobs, one-time packages</td>
            <td class="p-3">$399 for 500 applications, $599 for 1,000, $999 for 1,500</td>
            <td class="p-3">scale.jobs/pricing/one-time, fetched November 1, 2026</td>
          </tr>
          <tr class="border-b border-ink/10">
            <td class="p-3">Scale.jobs, monthly plans</td>
            <td class="p-3">$99 a month for 100 applications, $149 for 250, $199 for 500, $499 for 750</td>
            <td class="p-3">scale.jobs/pricing/subscription, fetched November 1, 2026</td>
          </tr>
          <tr class="border-b border-ink/10">
