---
interface Props {
  variant: "cost" | "pay" | "best";
}
const { variant } = Astro.props;

const cost =
  "We make ApplyScout. We have a conflict of interest, and here is how we handled it: every Scout price below comes from our own pricing page, every other provider's price is quoted from that provider's own page with the date we read it, and we say where another option is cheaper.";
const pay =
  "Disclosure: We make ApplyScout. We have a conflict of interest, and here is how we handled it. Our prices come from our own pricing page. Every outside price links to the provider's own page with the date we read it. Where another type of help fits better, we say so.";
const best =
  "We make ApplyScout, and Scout is on this list. We have a conflict of interest, and here is how we handled it: services are listed alphabetically rather than ranked, Scout prices come from our own pricing page, every other provider's price is quoted from that provider's own page with the date we read it, and we say where another service is cheaper or a better fit.";
const text = variant === "cost" ? cost : variant === "pay" ? pay : best;
---
<p><em>{text}</em></p>
