---
import FAQ from "../FAQ.astro";

const salaryAnswer = "No. The price of your plan is the only fee. There is no placement fee and no percentage of your salary.";

const items = [
  {
    q: "How much does a job application service cost?",
    a: "Published prices from the providers' own pages, read on November 20, 2026, run from LoopCV's free plan to My Personal Recruiter's $899 to $2,499 a month. ApplyScout (Scout) costs $39 to $999 a month: AI Assistant plans are $39 (AI Essential, 150 applications a month) and $79 (AI Plus, 300 applications). Human Assistant plans are $299 (Focused Search, 250 applications), $499 (Full Search, 500 applications) and $999 (Career Campaign, 1,000 applications). Prepaying 90 days costs about 10% less. See the dated table above for other providers.",
  },
  {
    q: "How much does it cost to hire someone to apply for jobs for you?",
    a: "It depends on the provider. LoopCV's pricing page, read on November 20, 2026, has a free forever plan and paid plans from €9.99 a month. My Personal Recruiter, in a post dated April 9, 2026, read the same day, lists its reverse recruiting plans at $899 to $2,499 a month. At Scout, a Human Assistant costs $299, $499 or $999 a month, and the AI Assistant costs $39 or $79 a month. Read more about [paying someone to apply for jobs](/blog/pay-someone-to-apply-for-jobs-for-you).",
  },
  { q: "Is there a placement fee or a cut of my salary?", a: salaryAnswer },
  {
    q: "What is the 90-day prepaid price?",
    a: "$105 for AI Essential, $213 for AI Plus, $807 for Focused Search, $1,347 for Full Search and $2,697 for Career Campaign. That is about 10% less than paying the monthly price for three months.",
  },
  {
    q: "What does each application cost?",
    a: "Divide the monthly price by the monthly allowance. That gives about $0.26 on both AI plans, $1.20 on Focused Search and $1.00 on both Full Search and Career Campaign. This is a unit price for the work, not a measure of results, and it leaves out the time you spend reviewing.",
  },
  {
    q: "Does paying more guarantee interviews or offers?",
    a: "No. You pay for the application work: finding suitable openings, preparing your materials and completing the applications. Employers decide who they interview and hire, and Scout does not guarantee interviews or offers.",
  },
];
---
<FAQ items={items} class="not-prose" />
