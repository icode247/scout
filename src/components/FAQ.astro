---
interface QA { q: string; a: string; }
interface Props { items: QA[]; heading?: string; class?: string; schema?: boolean; }
const { items, heading = "Frequently asked questions", class: cls = "", schema = true } = Astro.props;

const LINK = /\[([^\]]+)\]\(([^)\s]+)\)/g;

function escapeHtml(value: string) {
  return value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
}

/** Visible FAQ text. Markdown links become their anchor words so JSON-LD matches the page. */
function visibleAnswer(answer: string) {
  return answer.replace(LINK, "$1");
}

function answerHtml(answer: string) {
  const parts: string[] = [];
  let last = 0;
  for (const match of answer.matchAll(LINK)) {
    const index = match.index ?? 0;
    parts.push(escapeHtml(answer.slice(last, index)));
    const href = match[2];
    const text = escapeHtml(match[1]);
    if (href.startsWith("/") || href.startsWith("https://")) {
      parts.push(`<a href="${escapeHtml(href)}" class="font-semibold text-brand-700 underline underline-offset-2">${text}</a>`);
    } else {
      parts.push(text);
    }
    last = index + match[0].length;
  }
  parts.push(escapeHtml(answer.slice(last)));
  return parts.join("");
}

const ld = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: items.map((i) => ({
    "@type": "Question",
    name: i.q,
    acceptedAnswer: { "@type": "Answer", text: visibleAnswer(i.a) },
  })),
};
---
<section class={cls}>
  {heading && <h2 class="text-3xl font-bold sm:text-4xl">{heading}</h2>}
  <div class="mt-8 divide-y divide-black/5 border-y border-black/5">
    {items.map((i) => (
      <details class="group py-5">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink [&::-webkit-details-marker]:hidden">
          {i.q}
          <svg class="shrink-0 text-ink-muted transition-transform duration-200 group-open:rotate-45" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
        </summary>
        {i.a.includes("](") ? (
          <p class="mt-3 max-w-prose text-[0.95rem] leading-relaxed text-ink-soft" set:html={answerHtml(i.a)} />
        ) : (
          <p class="mt-3 max-w-prose text-[0.95rem] leading-relaxed text-ink-soft">{i.a}</p>
        )}
      </details>
    ))}
  </div>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
</section>
