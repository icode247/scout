---
/**
 * Visible hold for copy Clinton has not approved.
 * The withheld sentence belongs in a TODO(CLINTON-DECISION) comment at the call site,
 * not in this component's rendered text.
 */
interface Props {
  id: string;
  class?: string;
}
const { id, class: cls = "" } = Astro.props;
---
<aside id={`clinton-decision-${id}`} data-clinton-decision={id} class:list={["not-prose my-4 rounded-2xl border border-dashed border-human-700/50 bg-human-50 px-4 py-3 text-sm leading-relaxed text-ink", cls]}>
  <p class="font-extrabold text-human-700">Pending Clinton's decision</p>
  <div class="mt-1 space-y-2"><slot /></div>
</aside>
