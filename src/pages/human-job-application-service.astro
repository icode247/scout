---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import FAQ from "../components/FAQ.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import MarketingCTA from "../components/MarketingCTA.astro";
import { planByCode, regionalPriceLabel } from "../config/plans";
import { visitorRegion } from "../lib/region";

const focused = planByCode("human_focused")!;
const region = visitorRegion(Astro.request);
const focusedPrice = region ? regionalPriceLabel(focused, region) : focused.priceLabel;

const faqs = [
  { q: "Can someone apply for jobs for me while I work full time?", a: "Yes. You tell us your target roles, locations, work arrangement, and dealbreakers. Your dedicated assistant finds matching openings, tailors your resume for each one, and submits the applications. You stay in touch through WhatsApp and handle the interviews." },
  { q: "Will you invent experience when tailoring my resume?", a: "No. We adjust the wording and emphasis of your real experience to match each job description, including the keywords applicant tracking systems look for. We do not add jobs, skills, projects, or results you do not have." },
  { q: "How do you choose which jobs to apply to?", a: "Your assistant applies only to openings that match the preferences in your job profile. They skip roles that break your dealbreakers and check that postings are recent and from real companies. You can change your preferences at any time in WhatsApp." },
  { q: "Can I see what was submitted in my name?", a: "Yes. In your dashboard, every application shows the job, the resume used, and screenshots or records of important form answers." },
  { q: "How much does a human job application service cost?", a: `${focused.name} is ${focused.priceLabel} a month for ${focused.applicationsQuota} applications, and you can cancel anytime. Larger plans and a discounted 90-day option are listed on the pricing page, with local-currency prices in some countries.` },
  { q: "Do you charge a percentage of my salary if I get hired?", a: "No. The price of your plan is the only fee. There is no placement fee and no percentage of your salary." },
  { q: "Do you guarantee interviews?", a: "No. You pay for the application work: finding suitable openings, preparing your materials, and completing the applications. Employers decide who they interview and hire." },
];
---
<Base title="Human Job Application Service for Busy Professionals" description="Working full time? A dedicated human assistant finds matching jobs, tailors your resume using your real experience, and applies for you. No percentage of your salary.">
  <section class="relative min-h-[720px] overflow-hidden bg-brand-950 text-white"><img src="/assets/scout-human-review.webp" alt="A Scout human assistant reviewing an important application" width="1400" height="760" class="absolute inset-0 h-full w-full object-cover object-[35%_center]" /><div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(16,33,13,.16),rgba(16,33,13,.34)_48%,rgba(16,33,13,.98)_72%)]"></div><Container class="relative flex min-h-[720px] items-center justify-end py-20"><div class="max-w-xl"><span class="rounded-full bg-human-500 px-3 py-1.5 text-sm font-bold text-white">Human Job Application Service</span><h1 class="mt-6 font-display text-5xl font-extrabold leading-[0.98] tracking-[-0.035em] text-white sm:text-7xl">Keep working. Your assistant applies for you.</h1><p class="mt-6 text-lg leading-relaxed text-white/72">Applying for jobs can feel like a second full-time job. Your dedicated human assistant finds roles that match your preferences, tailors your resume using your real experience, and applies on your behalf. You stay in touch in WhatsApp and can check every application in your dashboard.</p><div class="mt-8 flex flex-col gap-3 sm:flex-row"><Button href="/pricing#human" size="lg" class="rounded-full bg-brand-300 text-ink">Get my assistant</Button><Button href="/book-call" size="lg" variant="ghost" class="rounded-full bg-white/10 text-white hover:bg-white/15">Book a free call</Button></div><p class="mt-4 text-sm font-semibold text-white/65">{focused.name}: {focusedPrice} a month for {focused.applicationsQuota} applications. Cancel anytime. No placement fee. No percentage of your salary.</p></div></Container></section>
  <section class="bg-white py-20 sm:py-28"><Container><div class="mx-auto max-w-3xl text-center"><h2 class="font-display text-4xl font-extrabold sm:text-6xl">What your dedicated assistant handles.</h2><p class="mx-auto mt-5 max-w-2xl text-lg text-ink-soft">Built for professionals who want a better role but don&apos;t have the evenings to apply for one.</p></div><div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4"><div class="rounded-2xl bg-human-50 p-6"><strong>Roles that fit</strong><p class="mt-2 text-sm text-ink-soft">Your target roles, locations, remote or hybrid preference, and dealbreakers come first. We choose fit over volume.</p></div><div class="rounded-2xl bg-surface p-6"><strong>Truthful tailoring</strong><p class="mt-2 text-sm text-ink-soft">A resume tailored to each job description from your real experience. Nothing invented.</p></div><div class="rounded-2xl bg-human-50 p-6"><strong>The applications themselves</strong><p class="mt-2 text-sm text-ink-soft">Your assistant fills in the forms and submits across job boards and applicant tracking systems.</p></div><div class="rounded-2xl bg-surface p-6"><strong>A person you can message</strong><p class="mt-2 text-sm text-ink-soft">A dedicated WhatsApp group for changing preferences or pointing your assistant to a job you found.</p></div></div></Container></section>
  <section class="bg-surface py-20 sm:py-28"><Container><div class="grid items-center gap-10 lg:grid-cols-2"><div><p class="text-lg font-bold text-human-700">Nothing hidden</p><h2 class="mt-3 font-display text-4xl font-extrabold sm:text-6xl">Know what was sent in your name.</h2><p class="mt-5 text-lg leading-relaxed text-ink-soft">Open any application to see the job, the resume used, and screenshots or records of important form answers. Then message your assistant in WhatsApp if anything should change.</p></div><ProductScreenshot variant="human" /></div></Container></section>
  <section class="bg-white py-20 sm:py-28"><Container><div class="grid items-center gap-10 lg:grid-cols-2"><div class="relative min-h-[470px] overflow-hidden rounded-2xl"><img src="/assets/scout-swipe-review.webp" alt="A job seeker reviewing Scout matches on a phone" width="1400" height="760" loading="lazy" class="absolute inset-0 h-full w-full object-cover" /></div><div><p class="text-lg font-bold text-brand-700">Clear about what you pay for</p><h2 class="mt-3 font-display text-4xl font-extrabold sm:text-6xl">You pay for the work. Your salary stays yours.</h2><p class="mt-5 text-lg leading-relaxed text-ink-soft">Your plan covers finding suitable openings, preparing your materials, and completing the applications. There is no placement fee and no percentage of your salary. Employers decide who they interview, so we don&apos;t guarantee interviews.</p><a href="/pricing#human" class="mt-6 inline-flex font-extrabold text-brand-700">Compare Human plans and terms →</a></div></div></Container></section>
  <Container><div class="py-16 sm:py-24"><FAQ items={faqs} /></div></Container>
  <MarketingCTA title="Hand your job search to a dedicated assistant." body="Choose a plan and your assistant starts with a short kickoff call and your private WhatsApp group. Prefer to talk before paying? Book a free call." />
</Base>
