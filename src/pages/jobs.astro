---
import App from "../layouts/App.astro";
import AddJobDialog from "../components/AddJobDialog.astro";
import JobSearchFilters from "../components/JobSearchFilters.astro";
import { loadScoutData } from "../lib/scout-data";
import { assignedHumanAssistant } from "../lib/human-assistants";
import { sanitizeJobDescription } from "../lib/job-description";
export const prerender = false;
const user = Astro.locals.user!;
const isAi = Astro.locals.scoutProfile?.assistant_type === "ai";
const data = await loadScoutData(user, Astro.locals.supabase, Astro.locals.demoMode, Astro.locals.scoutProfile);
const humanAssistant = assignedHumanAssistant(user.id, data.profile.assistant_name);
const activeProfiles = data.jobProfiles.filter((profile) => profile.active);
const activeSearchFilter = Astro.locals.demoMode || !Astro.locals.supabase ? null : (await Astro.locals.supabase.from("job_search_filters").select("id,job_profile_id,name").eq("user_id",user.id).eq("is_active",true).order("updated_at",{ascending:false}).limit(1).maybeSingle()).data;
const visibleJobs = data.jobs.filter((job) => { const actedOn=["delegated","preparing","applied","interview"].includes(job.status); if(actedOn)return true; if(["fastapply_match","fastapply_job_board"].includes(String(job.source||"")))return false; if(job.source==="job_search"&&activeSearchFilter)return job.fit_analysis?.search_filter_id===activeSearchFilter.id; return true; });
const profilesIndex = new Map(data.jobProfiles.map((profile) => [profile.id, profile]));
const jobs = visibleJobs.map(job => {
  const profile = job.job_profile_id ? profilesIndex.get(job.job_profile_id) ?? null : null;
  const fitAnalysis = job.fit_analysis as { matched_skills?: string[]; summary?: string; logo_url?: string; date_posted?: string };
  const sourceDate = fitAnalysis?.date_posted && !Number.isNaN(new Date(fitAnalysis.date_posted).getTime()) ? new Date(fitAnalysis.date_posted) : new Date(job.created_at);
  const primaryResume = data.resumes.find((resume) => resume.id === profile?.resume_ids?.[0]);
  const hasApplication = data.applications.some((application) => application.job_id === job.id);
  return {
    ...job,
    posted: new Intl.RelativeTimeFormat("en",{numeric:"auto"}).format(Math.round((sourceDate.getTime()-Date.now())/86400000),"day"),
    companyLogo: fitAnalysis?.logo_url || null,
    hasFitScore: typeof job.fit_score === "number",
    initials: job.company.split(/\s+/).map((part:string)=>part[0]).join("").slice(0,2).toUpperCase(),
    resume: primaryResume?.name || "Resume must be attached to this profile",
    summary: job.description || "No job description was provided. Open the original listing or paste the description when adding the job.",
    summaryHtml: sanitizeJobDescription(job.description || "No job description was provided. Open the original listing or paste the description when adding the job."),
    skills: Array.isArray(fitAnalysis?.matched_skills) && fitAnalysis.matched_skills.length
      ? fitAnalysis.matched_skills
      : (profile?.target_roles.length ? profile.target_roles : ["Role fit", "Experience", "Location"]),
    fitSummary: fitAnalysis?.summary || "Review the role details and send it to your assistant when it looks right.",
    profileName: profile?.name || "General profile",
    canEdit: !hasApplication,
    assistantName: job.assistant_type === "human"
      ? (data.profile.assistant_type === "human" && data.profile.assistant_name ? data.profile.assistant_name : "Human Assistant")
      : "Scout AI",
  };
});
const first = jobs[0] || null;
const matchingProfileIds = activeSearchFilter ? [activeSearchFilter.job_profile_id] : activeProfiles.slice(0,1).map(profile => profile.id);
const activeSearchFilterId = activeSearchFilter?.id || "";
const firstIsQueued = first ? ["delegated", "preparing", "applied", "interview"].includes(first.status) : false;
---
<App title="Jobs" active="jobs">
  <header class="jobs-toolbar"><div class="search-context"><span class="context-label">Showing results for</span><JobSearchFilters profiles={activeProfiles}/><label class="profile-control"><span class="sr-only">Job profile</span><select id="profile-filter" class="jobs-select"><option value="all">All profiles</option>{data.jobProfiles.map(profile=><option value={profile.id}>{profile.name}</option>)}</select></label></div><div class="toolbar-actions"><label class="jobs-search" for="job-search"><span aria-hidden="true">⌕</span><input id="job-search" type="search" placeholder="Search by job title, company, or keywords" autocomplete="off"/></label>{!isAi && <AddJobDialog profiles={activeProfiles}/>}</div></header>
  <div class="jobs-controls"><div class="jobs-tabs" role="tablist"><button class="job-tab is-active" data-status="all">Search <span>{jobs.length}</span></button><button class="job-tab" data-status="saved">Saved <span>{jobs.filter(j=>j.is_saved).length}</span></button><button class="job-tab" data-status="delegated">Delegated <span>{jobs.filter(j=>j.status==="delegated"||j.status==="preparing").length}</span></button><button class="job-tab" data-status="applied">Applied <span>{jobs.filter(j=>j.status==="applied"||j.status==="interview").length}</span></button></div></div>
  {first ? <div class="jobs-workspace">
    <aside class="jobs-results"><div class="results-heading"><div><strong id="result-count">{jobs.length} jobs</strong><p>Matched for your profiles</p></div><span>☷</span></div><div id="job-results" class="divide-y divide-ink/10">{jobs.map((job,index)=><button type="button" class:list={["job-result",index===0&&"is-selected"]} data-index={index} data-id={job.id} data-status={job.status} data-saved={job.is_saved ? "true" : "false"} data-profile={job.job_profile_id || ""} data-search={`${job.title} ${job.company} ${job.skills.join(" ")}`.toLowerCase()}><span class="job-result-main"><span class="company-mark">{job.companyLogo ? <img src={job.companyLogo} alt="" loading="lazy" referrerpolicy="no-referrer"/> : job.initials}</span><span class="job-result-copy"><strong>{job.title}</strong><span class="job-company">{job.company}</span><span class="job-location">{job.location || "Location not set"}</span></span></span><span class="job-posted">Posted {job.posted}</span></button>)}</div><div id="load-more-jobs" role="status" aria-live="polite" class="mx-auto my-4 block px-4 py-2 text-xs font-bold text-ink-muted">Loading more jobs…</div><div id="jobs-empty" class="hidden p-8 text-center"><strong>No jobs found.</strong><p class="mt-2 text-sm text-ink-muted">Try another search or profile.</p></div></aside>
    <section class:list={["job-detail",isAi?"is-ai":"is-human"]}><header class="detail-heading"><div class="min-w-0"><p class="text-sm text-ink-muted"><strong id="detail-company" class="text-ink">{first.company}</strong> · <span id="detail-posted">{first.posted}</span></p><h2 id="detail-title" class="mt-2 text-3xl font-extrabold">{first.title}</h2><p id="detail-location" class="mt-2 text-sm text-ink-soft">{first.location}</p></div><div class="detail-actions"><button id="save-job" class="icon-button" aria-label="Save job" aria-pressed={first.is_saved ? "true" : "false"}>{first.is_saved ? "♥" : "♡"}</button><button id="delegate-job" class="primary-action" disabled={firstIsQueued}>{firstIsQueued ? "In assistant queue ✓" : isAi ? "Apply with Scout AI →" : `Send to ${first.assistantName} →`}</button></div></header>
      <div class="handoff">
        <div class="assistant-identity">
          {isAi
            ? <span class="ai-mark" aria-hidden="true"><i></i><b>✦</b></span>
            : <span class="human-mark"><img src={humanAssistant.avatar} alt="" /></span>}
          <div class="min-w-0">
            <div class="assistant-label-row"><p id="assistant-type" class="assistant-label">{isAi ? "AI ASSISTANT" : "HUMAN ASSISTANT"}</p><span class="assistant-status"><i></i>{firstIsQueued ? "In progress" : "Ready to apply"}</span></div>
            <h3><span id="assistant-name">{first.assistantName}</span> can take it from here.</h3>
            <p>{isAi ? "Scout checks the role, prepares your documents, and submits using your saved answers." : "Your assistant reviews the details, handles edge cases, and keeps evidence of the submitted form."}</p>
          </div>
        </div>
        <div class="handoff-meta">
          <span>Applying with</span><strong id="profile-name">{first.profileName}</strong>
          <small>{isAi ? "Resume + saved answers attached" : "Resume + human review attached"}</small>
        </div>
      </div>
      <div class="tool-tabs"><button class="tool-tab is-active" data-tool="fit">◎ Job overview</button><button class="tool-tab" data-tool="resume">▤ Resume</button><button class="tool-tab" data-tool="answers">☷ Answer plan</button></div>
      <div class="detail-body"><section id="fit-panel" class="tool-panel"><div class="fit-summary"><div id="detail-score-ring" class="fit-ring" style={`--match-score:${first.fit_status === "complete" ? first.fit_score : 0}`}><strong id="detail-score">{first.fit_status === "complete" ? first.fit_score : "—"}</strong><span id="detail-score-label">{first.fit_status === "complete" ? "% fit" : "analyzing"}</span></div><div><h3 class="text-lg font-extrabold">Job information</h3><p id="fit-summary-text" class="mt-1 text-sm leading-relaxed text-ink-soft">{first.fitSummary}</p></div></div><h3 class="mt-7 font-extrabold">Profile targets</h3><div id="detail-skills" class="mt-3 flex flex-wrap gap-2">{first.skills.map(skill=><span class="skill-tag is-match">✓ {skill}</span>)}</div></section><section id="resume-panel" class="tool-panel hidden"><h3 class="text-lg font-extrabold">Resume Scout will use</h3><p class="mt-2 text-sm text-ink-soft">Your job profile controls whether Scout tailors a copy or keeps your original.</p><div class="document-row"><span class="document-icon">PDF</span><strong id="detail-resume" class="block truncate">{first.resume}</strong></div></section><section id="answers-panel" class="tool-panel hidden"><h3 class="text-lg font-extrabold">Application answer plan</h3><p class="mt-2 text-sm text-ink-soft">Known answers come from your profile. A Human Assistant asks in WhatsApp before ambiguous answers.</p></section><section class="role-section mt-8 border-t border-ink/10 pt-7"><h3 class="text-lg font-extrabold">About the role</h3><div id="detail-summary" class="job-description-scroll job-description-content mt-3 w-full text-sm leading-7 text-ink-soft" set:html={first.summaryHtml}></div><div class="mt-5 flex flex-wrap items-center justify-between gap-3"><a id="original-link" href={first.external_url || "#"} target="_blank" rel="noopener noreferrer" class:list={["inline-flex text-sm font-extrabold text-brand-700",!first.external_url&&"hidden"]}>Open original listing →</a><div id="job-manage-actions" class:list={["flex gap-3",!first.canEdit&&"hidden"]}><button id="edit-job" type="button" class="text-sm font-bold text-brand-800">Edit details</button><button id="delete-job" type="button" class="text-sm font-bold text-red-700">Delete job</button></div></div></section></div>
    </section>
  </div> : <div class="mt-8 rounded-xl bg-white p-12 text-center shadow-card"><h2 class="text-2xl font-extrabold">Scout is finding jobs for you</h2><p class="mx-auto mt-3 max-w-md text-ink-soft">Matching jobs will appear here automatically based on your active profiles. You can also add a specific job for your assistant.</p>{!isAi && <div class="mt-6"><AddJobDialog profiles={activeProfiles} id="jobs-empty-add"/></div>}</div>}
  <dialog id="edit-job-dialog" class="w-[min(92vw,38rem)] rounded-2xl bg-white p-0 text-ink shadow-lift backdrop:bg-ink/55"><form id="edit-job-form" class="p-6 sm:p-8"><input type="hidden" name="id"/><input type="hidden" name="action" value="edit"/><div class="flex items-start justify-between gap-4"><div><h2 class="text-2xl font-extrabold">Edit saved job</h2><p class="mt-2 text-sm text-ink-soft">Changes trigger a fresh profile match score.</p></div><button type="button" data-close-edit class="grid h-10 w-10 place-items-center rounded-full bg-surface" aria-label="Close job editor">×</button></div><div class="mt-6 grid gap-4 sm:grid-cols-2"><label class="text-sm font-bold">Job title<input required maxlength="180" name="title" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label><label class="text-sm font-bold">Company<input required maxlength="180" name="company" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label><label class="text-sm font-bold">Location<input maxlength="240" name="location" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label><label class="text-sm font-bold">Job profile<select name="job_profile_id" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3 font-normal">{data.jobProfiles.map(profile=><option value={profile.id}>{profile.name}</option>)}</select></label><label class="text-sm font-bold sm:col-span-2">Job URL<input name="external_url" type="url" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label><label class="text-sm font-bold sm:col-span-2">Description<textarea name="description" rows="6" class="mt-2 w-full resize-y rounded-xl border border-ink/15 px-4 py-3 font-normal"></textarea></label></div><p data-edit-error class="mt-4 hidden rounded-lg bg-red-50 p-3 text-sm font-bold text-red-700" role="alert"></p><div class="mt-6 flex justify-end gap-3"><button type="button" data-close-edit class="rounded-full px-5 py-3 text-sm font-bold">Cancel</button><button type="submit" class="rounded-full bg-ink px-5 py-3 text-sm font-extrabold text-white">Save and rescore</button></div></form></dialog>
  <script define:vars={{ jobs, isAi, matchingProfileIds, activeSearchFilterId }}>
    let results=[...document.querySelectorAll(".job-result")],statusTabs=[...document.querySelectorAll(".job-tab")],toolTabs=[...document.querySelectorAll(".tool-tab")],search=document.querySelector("#job-search"),profileFilter=document.querySelector("#profile-filter");let status="all",selected=jobs[0];
    function filter(){const query=search?.value.trim().toLowerCase()||"",profile=profileFilter?.value||"all";let count=0;results.forEach(button=>{const group=status==="all"||(status==="saved"&&button.dataset.saved==="true")||(status!=="saved"&&button.dataset.status===status)||(status==="delegated"&&button.dataset.status==="preparing")||(status==="applied"&&button.dataset.status==="interview");const show=group&&(profile==="all"||button.dataset.profile===profile)&&(!query||(button.dataset.search || "").includes(query));button.classList.toggle("hidden",!show);if(show)count++});document.querySelector("#jobs-empty")?.classList.toggle("hidden",count!==0);if(document.querySelector("#result-count"))document.querySelector("#result-count").textContent=count+(count===1?" job":" jobs")}
    function render(job){selected=job;document.querySelector("#detail-company").textContent=job.company;document.querySelector("#detail-posted").textContent=job.posted;document.querySelector("#detail-title").textContent=job.title;document.querySelector("#detail-location").textContent=job.location||"Location not set";document.querySelector("#detail-score").textContent=job.fit_status==="complete"?job.fit_score:"—";document.querySelector("#detail-score-ring").style.setProperty("--match-score",String(job.fit_status==="complete"?job.fit_score:0));document.querySelector("#detail-score-label").textContent=job.fit_status==="complete"?"% fit":job.fit_status==="failed"?"unavailable":"analyzing";document.querySelector("#fit-summary-text").textContent=job.fitSummary;document.querySelector("#detail-summary").innerHTML=job.summaryHtml;document.querySelector("#detail-resume").textContent=job.resume;document.querySelector("#profile-name").textContent=job.profileName;document.querySelector("#assistant-name").textContent=job.assistantName;document.querySelector("#assistant-type").textContent=job.assistant_type.toUpperCase()+" ASSISTANT";const skills=document.querySelector("#detail-skills");skills.replaceChildren(...job.skills.map(skill=>{const tag=document.createElement("span");tag.className="skill-tag is-match";tag.textContent="✓ "+skill;return tag}));const link=document.querySelector("#original-link");link.href=job.external_url||"#";link.classList.toggle("hidden",!job.external_url);const done=["delegated","preparing","applied","interview"].includes(job.status),delegate=document.querySelector("#delegate-job");delegate.textContent=done?"In assistant queue ✓":isAi?"Apply with Scout AI →":"Send to "+job.assistantName+" →";delegate.disabled=done;document.querySelector("#job-manage-actions").classList.toggle("hidden",!job.canEdit);document.querySelector("#save-job").setAttribute("aria-pressed",job.is_saved?"true":"false");document.querySelector("#save-job").textContent=job.is_saved?"♥":"♡"}
    async function setStatus(next){const response=await fetch("/api/app/jobs",{method:"PATCH",headers:{"content-type":"application/json"},body:JSON.stringify({id:selected.id,status:next})});const data=await response.json();if(!response.ok){window.scoutToast?.(data.error||"Could not update job",true);return false}selected.status=next;const button=results.find(item=>item.dataset.id===selected.id);if(button)button.dataset.status=next;window.scoutToast?.(next==="delegated"?"Job sent to your assistant":"Job updated");return true}
    function bindResult(button){button.addEventListener("click",()=>{results.forEach(item=>item.classList.remove("is-selected"));button.classList.add("is-selected");render(jobs[Number(button.dataset.index)])})}
    results.forEach(bindResult);
    function installLogoFallback(button,job){const image=button.querySelector(".company-mark img");if(!image)return;const fallback=()=>{const mark=image.parentElement;if(mark){image.remove();mark.textContent=job.initials||"—"}};image.addEventListener("error",fallback,{once:true});if(image.complete&&image.naturalWidth===0)fallback()}
    results.forEach(button=>installLogoFallback(button,jobs[Number(button.dataset.index)]));
    function relativePosted(value){if(!value)return "recently";const date=new Date(value);if(Number.isNaN(date.getTime()))return "recently";const days=Math.round((date.getTime()-Date.now())/86400000);return new Intl.RelativeTimeFormat("en",{numeric:"auto"}).format(days,"day")}
    function escapeHtml(value){return String(value==null?"":value).replace(/[&<>"']/g,ch=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[ch]))}
    function appendBoardJobs(incoming){const list=document.querySelector("#job-results");if(!list)return 0;let added=0;for(const raw of incoming||[]){if(!raw?.external_url||jobs.some(job=>job.external_url===raw.external_url))continue;const job={...raw,posted:relativePosted(raw.posted_at),hasFitScore:false,resume:"Profile resume",summary:raw.description||"No description available.",summaryHtml:typeof raw.summaryHtml==="string"?raw.summaryHtml:escapeHtml(raw.description||"No description available.").replace(/\n/g,"<br>"),skills:[raw.employment_type,raw.fit_analysis?.workplace_type].filter(Boolean),fitSummary:"Review the job details before saving or applying.",canEdit:false,assistantName:raw.assistant_type==="human"?"Human Assistant":"Scout AI"};const index=jobs.push(job)-1,button=document.createElement("button");button.type="button";button.className="job-result";Object.assign(button.dataset,{index:String(index),id:job.id,status:job.status,saved:"false",profile:job.job_profile_id||"",search:(job.title+" "+job.company+" "+job.skills.join(" ")).toLowerCase()});const main=document.createElement("span"),mark=document.createElement("span"),copy=document.createElement("span"),title=document.createElement("strong"),company=document.createElement("span"),location=document.createElement("span"),posted=document.createElement("span");main.className="job-result-main";mark.className="company-mark";copy.className="job-result-copy";title.textContent=job.title;company.className="job-company";company.textContent=job.company;location.className="job-location";location.textContent=job.location||"Location not set";posted.className="job-posted";posted.textContent="Posted "+job.posted;if(job.companyLogo){const image=document.createElement("img");image.src=job.companyLogo;image.alt="";image.loading="lazy";image.referrerPolicy="no-referrer";image.addEventListener("error",()=>{image.remove();mark.textContent=job.initials||"—"},{once:true});mark.append(image)}else mark.textContent=job.initials||"—";copy.append(title,company,location);main.append(mark,copy);button.append(main,posted);const scopedAttribute=[...list.querySelector(".job-result")?.attributes||[]].find(attribute=>attribute.name.startsWith("data-astro-cid-"))?.name;if(scopedAttribute)[button,...button.querySelectorAll("*")].forEach(element=>element.setAttribute(scopedAttribute,""));list.append(button);results.push(button);bindResult(button);added++}filter();return added}
    statusTabs.forEach(tab=>tab.addEventListener("click",()=>{status=tab.dataset.status;statusTabs.forEach(item=>item.classList.toggle("is-active",item===tab));filter()}));search?.addEventListener("input",filter);profileFilter?.addEventListener("change",filter);
    toolTabs.forEach(tab=>tab.addEventListener("click",()=>{toolTabs.forEach(item=>item.classList.toggle("is-active",item===tab));document.querySelectorAll(".tool-panel").forEach(panel=>panel.classList.add("hidden"));document.querySelector("#"+tab.dataset.tool+"-panel")?.classList.remove("hidden")}));
    document.querySelector("#delegate-job")?.addEventListener("click",async event=>{event.currentTarget.disabled=true;if(isAi){try{const response=await fetch("/api/app/ai-jobs",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({...selected,localId:selected.id,profileId:selected.job_profile_id,url:selected.external_url})});const data=await response.json();if(!response.ok)throw new Error(data.error||"Could not queue application");selected.status="delegated";render(selected);window.scoutToast?.("Scout is applying to this job.")}catch(error){event.currentTarget.disabled=false;window.scoutToast?.(error instanceof Error?error.message:"Could not queue application",true)}}else if(await setStatus("delegated"))render(selected);else event.currentTarget.disabled=false});
    document.querySelector("#save-job")?.addEventListener("click",async event=>{
      const button=event.currentTarget,job=selected,previous=Boolean(job.is_saved),next=!previous;
      const syncSavedState=(value)=>{job.is_saved=value;button.setAttribute("aria-pressed",value?"true":"false");button.textContent=value?"♥":"♡";const resultButton=results.find(item=>item.dataset.id===job.id);if(resultButton)resultButton.dataset.saved=value?"true":"false";const savedCount=document.querySelector(".job-tab[data-status=saved] span");if(savedCount)savedCount.textContent=String(results.filter(item=>item.dataset.saved==="true").length);filter()};
      syncSavedState(next);
      button.disabled=true;
      try{
        const response=await fetch("/api/app/jobs",{method:"PATCH",headers:{"content-type":"application/json"},body:JSON.stringify({id:job.id,is_saved:next})});
        const data=await response.json();
        if(!response.ok)throw new Error(data.error||"Could not save job");
        window.scoutToast?.(next?"Job saved":"Job removed from saved");
      }catch(error){
        syncSavedState(previous);
        window.scoutToast?.(error instanceof Error?error.message:"Could not save job",true);
      }finally{button.disabled=false}
    });
    const editDialog=document.querySelector("#edit-job-dialog"),editForm=document.querySelector("#edit-job-form");
    document.querySelector("#edit-job")?.addEventListener("click",()=>{if(!selected?.canEdit)return;editForm.reset();editForm.elements.id.value=selected.id;editForm.elements.title.value=selected.title;editForm.elements.company.value=selected.company;editForm.elements.location.value=selected.location||"";editForm.elements.job_profile_id.value=selected.job_profile_id||"";editForm.elements.external_url.value=selected.external_url||"";editForm.elements.description.value=selected.description||"";editForm.querySelector("[data-edit-error]").classList.add("hidden");editDialog.showModal()});
    editDialog?.querySelectorAll("[data-close-edit]").forEach(button=>button.addEventListener("click",()=>editDialog.close()));
    editDialog?.addEventListener("click",event=>{if(event.target===editDialog)editDialog.close()});
    editForm?.addEventListener("submit",async event=>{event.preventDefault();const button=editForm.querySelector("[type=submit]"),error=editForm.querySelector("[data-edit-error]");button.disabled=true;button.textContent="Saving and scoring…";error.classList.add("hidden");try{const body=Object.fromEntries(new FormData(editForm).entries());const response=await fetch("/api/app/jobs",{method:"PATCH",headers:{"content-type":"application/json"},body:JSON.stringify(body)});const data=await response.json();if(!response.ok)throw new Error(data.error||"Could not update job");location.reload()}catch(reason){error.textContent=reason instanceof Error?reason.message:"Could not update job";error.classList.remove("hidden");button.disabled=false;button.textContent="Save and rescore"}});
    document.querySelector("#delete-job")?.addEventListener("click",async()=>{if(!selected?.canEdit||!confirm("Delete this saved job?"))return;const button=document.querySelector("#delete-job");button.disabled=true;const response=await fetch("/api/app/jobs?id="+encodeURIComponent(selected.id),{method:"DELETE"});const data=await response.json();if(response.ok)location.reload();else{button.disabled=false;window.scoutToast?.(data.error||"Could not delete job",true)}});
    const loadMoreButton=document.querySelector("#load-more-jobs"),resultsScroller=document.querySelector("#job-results");let loadingSearch=false,searchExhausted=false;
