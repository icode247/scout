---
import App from "../layouts/App.astro";
import { planByCode } from "../config/plans";
export const prerender = false;
const user = Astro.locals.user!;
const profile = Astro.locals.scoutProfile;
const name = profile?.full_name || user.user_metadata?.full_name || "";
const entitlement = Astro.locals.entitlement;
const plan = entitlement.planCode ? planByCode(entitlement.planCode) : null;
const usedPercent = entitlement.applicationsQuota
  ? Math.min(100, Math.round((entitlement.applicationsUsed / entitlement.applicationsQuota) * 100))
  : 0;
const renewsOn = null;
const billingRow = Astro.locals.demoMode || !Astro.locals.supabase
  ? null
  : (await Astro.locals.supabase.from("subscriptions").select("dodo_customer_id,current_period_end").eq("user_id", user.id).eq("status", "active").order("created_at", { ascending: false }).limit(1).maybeSingle()).data;
const periodEnd = billingRow?.current_period_end ? new Date(billingRow.current_period_end) : null;
---
<App title="Account settings" active="settings">
  <div class="max-w-3xl"><p class="text-sm font-extrabold text-signal-700">ACCOUNT</p><h1 class="mt-2 text-3xl font-extrabold">Settings</h1><p class="mt-2 text-ink-soft">Manage the identity attached to your Scout workspace.</p></div>
  <section class="mt-8 max-w-3xl rounded-xl bg-white p-6 shadow-card sm:p-8">
    <h2 class="text-xl font-extrabold">Personal details</h2>
    <form id="settings-form" class="mt-6 grid gap-5">
      <label class="text-sm font-bold">Full name<input name="full_name" value={name} minlength="2" maxlength="100" required class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label>
      <label class="text-sm font-bold">Email<input value={user.email} readonly class="mt-2 w-full rounded-xl border border-ink/10 bg-surface px-4 py-3 font-normal text-ink-muted"/><span class="mt-2 block text-xs font-normal text-ink-muted">Your sign-in email is managed by your authentication provider.</span></label>
      <div><button class="rounded-full bg-ink px-5 py-3 text-sm font-extrabold text-white">Save changes</button><p id="settings-error" class="mt-3 hidden text-sm font-bold text-red-700" role="alert"></p></div>
    </form>
  </section>
  <section class="mt-6 max-w-3xl rounded-xl bg-white p-6 shadow-card sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-4">
      <div>
        <h2 class="text-xl font-extrabold">Plan and billing</h2>
        <p class="mt-2 text-sm text-ink-soft">{entitlement.paid ? "Your applications and renewal details." : "Browsing and saving jobs is free. A plan lets Scout apply."}</p>
      </div>
      <span class={`rounded-full px-3 py-1.5 text-xs font-bold ${entitlement.paid ? "bg-signal-50 text-signal-700" : entitlement.reason === "past_due" ? "bg-red-50 text-red-700" : "bg-surface text-ink-muted"}`}>
        {entitlement.paid ? "Active" : entitlement.reason === "past_due" ? "Payment failed" : entitlement.status === "expired" ? "Expired" : "No plan"}
      </span>
    </div>

    {entitlement.paid ? (
      <div class="mt-6">
        <div class="flex flex-wrap items-end justify-between gap-3">
          <div>
            <strong class="text-lg">{plan?.name || entitlement.planCode}</strong>
            <p class="mt-1 text-sm text-ink-muted">{plan?.priceLabel} {plan?.cadenceLabel} · {entitlement.lane === "human" ? "Human Assistant" : "AI Assistant"}</p>
          </div>
          <p class="text-sm font-bold text-ink-soft">{entitlement.applicationsUsed} of {entitlement.applicationsQuota} applications used</p>
        </div>
        <div class="mt-3 h-2.5 overflow-hidden rounded-full bg-surface-sunken" role="progressbar" aria-valuenow={usedPercent} aria-valuemin="0" aria-valuemax="100" aria-label="Applications used">
          <div class={`h-full rounded-full ${usedPercent >= 90 ? "bg-red-500" : "bg-brand-500"}`} style={`width:${Math.max(2, usedPercent)}%`}></div>
        </div>
        <p class="mt-2 text-xs text-ink-muted">
          {entitlement.applicationsRemaining > 0 ? `${entitlement.applicationsRemaining} remaining` : "No applications remaining"}
          {periodEnd ? ` · renews ${new Intl.DateTimeFormat("en", { month: "long", day: "numeric", year: "numeric" }).format(periodEnd)}` : plan?.billing === "one_time" ? " · this bundle does not expire" : ""}
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {billingRow?.dodo_customer_id && <a href="/api/billing/portal" class="inline-flex min-h-11 items-center rounded-full bg-ink px-5 text-sm font-extrabold text-white">Manage billing</a>}
          <button type="button" data-open-pricing={entitlement.lane || "ai"} class="inline-flex min-h-11 items-center rounded-full bg-surface px-5 text-sm font-extrabold text-ink">{entitlement.applicationsRemaining > 0 ? "Change plan" : "Top up applications"}</button>
        </div>
      </div>
    ) : (
      <div class="mt-6">
        <p class="text-sm leading-relaxed text-ink-soft">You can build job profiles, search, and save jobs for free. Choose a plan when you want Scout to start applying on your behalf.</p>
        <button type="button" data-open-pricing={profile?.assistant_type === "human" ? "human" : "ai"} class="mt-5 inline-flex min-h-11 items-center rounded-full bg-ink px-5 text-sm font-extrabold text-white">Get Assistant</button>
      </div>
    )}
  </section>

  <section class="mt-6 max-w-3xl rounded-xl border border-red-200 bg-white p-6 sm:p-8"><h2 class="text-xl font-extrabold">Account and data</h2><p class="mt-2 text-sm leading-relaxed text-ink-soft">Deleting your account permanently removes your profiles, resumes, jobs, applications, and stored files.</p><a href="/delete-account" class="mt-5 inline-flex text-sm font-extrabold text-red-700">Delete my Scout account →</a></section>
  <script is:inline>
    document.getElementById("settings-form")?.addEventListener("submit",async event=>{event.preventDefault();const form=event.currentTarget,button=form.querySelector("button"),error=form.querySelector("#settings-error");button.disabled=true;button.textContent="Saving…";error.classList.add("hidden");try{const response=await fetch("/api/app/settings",{method:"PATCH",headers:{"content-type":"application/json"},body:JSON.stringify(Object.fromEntries(new FormData(form).entries()))});const data=await response.json();if(!response.ok)throw new Error(data.error||"Could not save settings");window.scoutToast?.("Settings saved");button.textContent="Saved";setTimeout(()=>{button.disabled=false;button.textContent="Save changes"},1200)}catch(reason){error.textContent=reason instanceof Error?reason.message:"Could not save settings";error.classList.remove("hidden");button.disabled=false;button.textContent="Save changes"}});
  </script>
</App>
