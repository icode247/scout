---
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import { createSupabaseServiceClient } from "../../lib/supabase";

export const prerender = false;

const token = Astro.url.searchParams.get("token")?.trim() || "";
let state: "confirm" | "done" | "invalid" | "error" = /^[0-9a-f-]{36}$/i.test(token) ? "confirm" : "invalid";

if (Astro.request.method === "POST" && state === "confirm") {
  const form = await Astro.request.formData();
  if (form.get("token") !== token) state = "invalid";
  else {
    const db = createSupabaseServiceClient();
    const result = await db.from("launch_email_enrollments")
      .update({ status: "unsubscribed", unsubscribed_at: new Date().toISOString(), claimed_at: null, updated_at: new Date().toISOString() })
      .eq("unsubscribe_token", token).in("status", ["active", "processing"]);
    state = result.error ? "error" : "done";
  }
}
---
<Base title="Email preferences | Scout" description="Manage the job-search emails you receive from Scout.">
  <section class="min-h-[calc(100dvh-5rem)] bg-[#f4f8ee] py-20">
    <Container>
      <div class="mx-auto max-w-lg rounded-2xl bg-white p-8 text-center shadow-card sm:p-10">
        <img src="/brand/concept-a/logo-horizontal.svg" alt="Scout" class="mx-auto h-10 w-auto" />
        {state === "confirm" && <>
          <h1 class="mt-8 text-3xl font-extrabold">Stop launch emails?</h1>
          <p class="mt-3 leading-relaxed text-ink-soft">You will no longer receive Scout’s launch and job-search guidance sequence. Account and purchase-related messages will still arrive when needed.</p>
          <form method="post" class="mt-7">
            <input type="hidden" name="token" value={token} />
            <button class="rounded-full bg-ink px-6 py-3 font-extrabold text-white">Unsubscribe me</button>
          </form>
        </>}
        {state === "done" && <>
          <h1 class="mt-8 text-3xl font-extrabold">You’re unsubscribed</h1>
          <p class="mt-3 leading-relaxed text-ink-soft">You will not receive any more emails from this sequence.</p>
          <a href="/" class="mt-7 inline-flex rounded-full bg-brand-400 px-6 py-3 font-extrabold text-ink">Return to Scout</a>
        </>}
        {state === "invalid" && <><h1 class="mt-8 text-3xl font-extrabold">That link is invalid</h1><p class="mt-3 text-ink-soft">Please use the unsubscribe link from your most recent Scout email.</p></>}
        {state === "error" && <><h1 class="mt-8 text-3xl font-extrabold">We couldn’t update that</h1><p class="mt-3 text-ink-soft">Try again shortly or reply to the email and we’ll help.</p></>}
      </div>
    </Container>
  </section>
</Base>
