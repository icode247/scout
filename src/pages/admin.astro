---
import App from "../layouts/App.astro";
import { adminEmails, agentAssignments, canWorkClient, createAdminClient, staffMember } from "../lib/admin";
import { allHumanAssistants, assignedHumanAssistant, rosterIsManaged, savedHumanAssistant } from "../lib/human-assistants";
import { clientsWithBriefs } from "../lib/client-briefs";
import { attentionReasons, summarizeWorkload, timeAgo, type ApplicationActivity } from "../lib/ops-overview";
export const prerender = false;
const staff = staffMember(Astro.locals.user);
if (!staff) return Astro.redirect("/dashboard", 303);
const isAdmin = staff.role === "admin";
const admin = createAdminClient();

// Paid Human clients only. Anyone who picked the human lane but never paid is a
// lead, not a client, and must not get an assistant's time.
const [profilesResult, subscriptionsResult] = await Promise.all([
  admin.from("profiles").select("user_id,full_name,email,assistant_name,whatsapp_phone,whatsapp_url,created_at").eq("assistant_type", "human"),
  admin.from("subscriptions").select("user_id,plan_code,applications_used,applications_quota,created_at").eq("lane", "human").eq("status", "active"),
]);
if (profilesResult.error || subscriptionsResult.error) throw profilesResult.error || subscriptionsResult.error;
const subscriptions = new Map((subscriptionsResult.data || []).map((row) => [row.user_id, row]));
const allHuman = profilesResult.data || [];
const paidClients = allHuman.filter((profile) => subscriptions.has(profile.user_id) && canWorkClient(staff, profile.assistant_name));
const unpaidCount = allHuman.filter((profile) => !subscriptions.has(profile.user_id)).length;
const clientIds = paidClients.map((client) => client.user_id);

const [applicationsResult, briefs] = await Promise.all([
  clientIds.length ? admin.from("applications").select("id,user_id,job_id,status,submitted_at,created_at").eq("assistant_type", "human").in("user_id", clientIds).order("created_at", { ascending: false }).limit(10000) : Promise.resolve({ data: [], error: null }),
  clientsWithBriefs(admin),
]);
if (applicationsResult.error) throw applicationsResult.error;
type OpsApplication = { id: string; user_id: string; job_id: string; status: string; submitted_at: string | null; created_at: string };
const applications = (applicationsResult.data || []) as OpsApplication[];
const byClient = new Map<string, ApplicationActivity[]>();
for (const row of applications) byClient.set(row.user_id, [...(byClient.get(row.user_id) || []), row]);

const now = Date.now();
const clients = paidClients.map((profile) => {
  const subscription = subscriptions.get(profile.user_id)!;
  const workload = summarizeWorkload(byClient.get(profile.user_id) || [], now);
  const applicationsLeft = Math.max(0, subscription.applications_quota - subscription.applications_used);
  const reasons = attentionReasons(workload, { hasWhatsapp: Boolean(profile.whatsapp_url), hasBrief: briefs.has(profile.user_id), applicationsLeft, startedAt: subscription.created_at }, now);
  const assistant = savedHumanAssistant(profile.assistant_name) ?? assignedHumanAssistant(profile.user_id, profile.assistant_name);
  return { ...profile, subscription, workload, applicationsLeft, reasons, assistant, hasBrief: briefs.has(profile.user_id) };
}).sort((a, b) => b.reasons.length - a.reasons.length || b.workload.requested - a.workload.requested || (a.full_name || a.email).localeCompare(b.full_name || b.email));

const totals = clients.reduce((sum, client) => ({
  today: sum.today + client.workload.appliedToday,
  week: sum.week + client.workload.appliedWeek,
  requested: sum.requested + client.workload.requested,
  attention: sum.attention + (client.reasons.length ? 1 : 0),
}), { today: 0, week: 0, requested: 0, attention: 0 });

// What each assistant is doing, built from the clients assigned to them.
// Logins come from agents added on this page, plus any legacy AGENT_EMAILS entries.
// Logins come from each agent's email on the roster, plus any legacy AGENT_EMAILS entries.
const roster = allHumanAssistants();
const managed = rosterIsManaged();
const logins = new Map<string, string>([...agentAssignments(), ...roster.filter((agent) => agent.email).map((agent) => [agent.email!.toLowerCase(), agent.name] as [string, string])]);
const loginsByAssistant = new Map<string, string[]>();
for (const [email, name] of logins) {
  const canonical = savedHumanAssistant(name)?.name ?? name;
  loginsByAssistant.set(canonical, [...(loginsByAssistant.get(canonical) || []), email]);
}
const agents = roster.map((assistant) => {
  const mine = clients.filter((client) => client.assistant.name === assistant.name);
  const last = mine.map((client) => client.workload.lastAppliedAt).filter((value): value is string => Boolean(value)).sort().pop() ?? null;
  return {
    assistant, clients: mine.length, logins: loginsByAssistant.get(assistant.name) || [],
    today: mine.reduce((sum, client) => sum + client.workload.appliedToday, 0),
    week: mine.reduce((sum, client) => sum + client.workload.appliedWeek, 0),
    requested: mine.reduce((sum, client) => sum + client.workload.requested, 0),
    attention: mine.filter((client) => client.reasons.length).length,
    last,
  };
}).filter((agent) => agent.clients > 0 || agent.logins.length > 0);

// Latest applications across these clients, for the activity feed.
const recent = applications.filter((row) => row.submitted_at).sort((a, b) => String(b.submitted_at).localeCompare(String(a.submitted_at))).slice(0, 25);
const recentJobIds = [...new Set(recent.map((row) => row.job_id))];
const jobsResult = recentJobIds.length ? await admin.from("jobs").select("id,title,company,external_url").in("id", recentJobIds) : { data: [], error: null };
if (jobsResult.error) throw jobsResult.error;
type OpsJob = { id: string; title: string; company: string; external_url: string | null };
const jobs = new Map<string, OpsJob>(((jobsResult.data || []) as OpsJob[]).map((job) => [job.id, job]));
const clientById = new Map(clients.map((client) => [client.user_id, client]));

// Admin only: people who filled in the intake form but are not paying clients yet.
let leads: Array<{ email: string; full_name: string; created_at: string }> = [];
if (isAdmin) {
  const intakes = await admin.from("assistant_intakes").select("email,full_name,created_at").order("created_at", { ascending: false }).limit(200);
  if (intakes.error) throw intakes.error;
  const clientEmails = new Set(clients.map((client) => String(client.email || "").toLowerCase()));
  const seen = new Set<string>();
  leads = (intakes.data || []).filter((row) => {
    const email = row.email.toLowerCase();
    if (seen.has(email) || clientEmails.has(email)) return false;
    seen.add(email);
    return true;
  }).slice(0, 20);
}
const intakeLink = new URL("/intake", Astro.url).toString();
const greeting = staff.assistantName ? (savedHumanAssistant(staff.assistantName)?.firstName ?? staff.assistantName) : "there";
const admins = [...adminEmails()];
---
<App title="Operations" active="admin">
  <header class="flex flex-wrap items-end justify-between gap-4">
    <div><p class="text-sm font-extrabold text-signal-700">{isAdmin ? "SCOUT OPERATIONS · ADMIN" : "SCOUT OPERATIONS"}</p><h1 class="mt-1 text-3xl font-extrabold">{isAdmin ? "Every client, every agent, at a glance." : `Hi ${greeting}, here are your clients.`}</h1><p class="mt-2 max-w-2xl text-ink-soft">{isAdmin ? "Clients that need attention are listed first. Open a client to upload their brief, set up their assistant, and see every job applied for them." : "Start with the clients at the top — they have requests waiting or nothing applied recently. Open a client to read their brief and log applications."}</p></div>
  </header>

  <section class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl bg-white p-4 shadow-card"><p class="text-xs font-extrabold text-ink-muted">APPLIED TODAY</p><strong class="mt-1 block text-3xl">{totals.today}</strong></div>
    <div class="rounded-xl bg-white p-4 shadow-card"><p class="text-xs font-extrabold text-ink-muted">APPLIED THIS WEEK</p><strong class="mt-1 block text-3xl">{totals.week}</strong></div>
    <div class="rounded-xl bg-white p-4 shadow-card"><p class="text-xs font-extrabold text-ink-muted">REQUESTS WAITING</p><strong class={`mt-1 block text-3xl ${totals.requested ? "text-human-700" : ""}`}>{totals.requested}</strong></div>
    <div class="rounded-xl bg-white p-4 shadow-card"><p class="text-xs font-extrabold text-ink-muted">CLIENTS NEEDING ATTENTION</p><strong class={`mt-1 block text-3xl ${totals.attention ? "text-human-700" : ""}`}>{totals.attention} <span class="text-base font-bold text-ink-muted">of {clients.length}</span></strong></div>
  </section>

  {isAdmin && <section class="mt-6 rounded-xl bg-white p-5 shadow-card sm:p-6">
    <div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-xl font-extrabold">Agents</h2><p class="mt-1 text-sm text-ink-soft">What each assistant is doing. Click a row to see only their clients.</p></div></div>
    <div class="mt-4 overflow-x-auto"><table class="w-full min-w-[720px] text-left text-sm"><thead><tr class="text-xs text-ink-muted"><th class="py-2 pr-3">Agent</th><th class="py-2 pr-3">Clients</th><th class="py-2 pr-3">Today</th><th class="py-2 pr-3">This week</th><th class="py-2 pr-3">Requests waiting</th><th class="py-2 pr-3">Need attention</th><th class="py-2 pr-3">Last application</th><th class="py-2">Login</th></tr></thead><tbody class="divide-y divide-ink/10">
      {agents.length ? agents.map((agent) => <tr class="cursor-pointer hover:bg-surface/60" data-agent-row={agent.assistant.name}><td class="py-3 pr-3"><span class="flex items-center gap-2"><img src={agent.assistant.avatar} alt="" class="h-8 w-8 rounded-full object-cover"/><strong>{agent.assistant.name}</strong></span></td><td class="py-3 pr-3">{agent.clients}</td><td class="py-3 pr-3 font-bold">{agent.today}</td><td class="py-3 pr-3">{agent.week}</td><td class={`py-3 pr-3 ${agent.requested ? "font-bold text-human-700" : ""}`}>{agent.requested}</td><td class={`py-3 pr-3 ${agent.attention ? "font-bold text-human-700" : ""}`}>{agent.attention}</td><td class="py-3 pr-3 text-ink-soft">{timeAgo(agent.last, now)}</td><td class="py-3 text-xs">{agent.logins.length ? agent.logins.join(", ") : <span class="font-bold text-human-700">No login yet — add an email under Manage agents</span>}</td></tr>) : <tr><td colspan="8" class="py-6 text-center text-ink-muted">No assistants have clients yet.</td></tr>}
    </tbody></table></div>
  </section>}

  <section class="mt-6 rounded-xl bg-white p-5 shadow-card sm:p-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div><h2 class="text-xl font-extrabold">{isAdmin ? "All clients" : "My clients"}</h2><p class="mt-1 text-sm text-ink-soft">Paid Human Assistant clients. {isAdmin && unpaidCount > 0 ? `${unpaidCount} more chose Human but have not paid.` : ""}</p></div>
      <div class="flex flex-wrap gap-2">
        <input data-client-search type="search" placeholder="Search name or email" class="rounded-full border border-ink/15 px-4 py-2 text-sm"/>
        {isAdmin && <select data-agent-filter class="rounded-full border border-ink/15 px-4 py-2 text-sm" aria-label="Filter by agent"><option value="">All agents</option>{roster.map((assistant) => <option value={assistant.name}>{assistant.name}</option>)}</select>}
        <label class="flex items-center gap-2 rounded-full bg-surface px-4 py-2 text-sm font-bold"><input data-attention-only type="checkbox"/> Needs attention</label>
      </div>
    </div>
    <div class="mt-4 divide-y divide-ink/10">
      {clients.length ? clients.map((client) => <a href={`/admin/clients/${client.user_id}`} data-client-row data-agent={client.assistant.name} data-attention={client.reasons.length ? "1" : "0"} data-search={`${client.full_name} ${client.email}`.toLowerCase()} class="grid gap-3 py-4 hover:bg-surface/60 lg:grid-cols-[1.3fr_1fr_1.4fr_auto] lg:items-center">
        <span class="flex min-w-0 items-center gap-3"><img src={client.assistant.avatar} alt="" class="h-9 w-9 flex-none rounded-full object-cover"/><span class="min-w-0"><strong class="block truncate">{client.full_name || client.email}</strong><span class="block truncate text-xs text-ink-muted">{client.email} · {client.assistant.name}</span></span></span>
        <span class="flex flex-wrap gap-2 text-xs font-bold"><span class="rounded-full bg-surface px-2.5 py-1">{client.workload.appliedToday} today</span><span class="rounded-full bg-surface px-2.5 py-1">{client.workload.appliedWeek} this week</span><span class="rounded-full bg-brand-100 px-2.5 py-1 text-brand-800">{client.applicationsLeft} left</span></span>
        <span class="flex flex-wrap gap-1.5 text-xs font-bold">{client.reasons.length ? client.reasons.map((reason) => <span class="rounded-full bg-human-50 px-2.5 py-1 text-human-700">{reason}</span>) : <span class="rounded-full bg-signal-50 px-2.5 py-1 text-signal-700">On track · last applied {timeAgo(client.workload.lastAppliedAt, now)}</span>}</span>
        <span class="text-sm font-extrabold text-brand-700">Open →</span>
      </a>) : <p class="py-8 text-center text-sm text-ink-muted">{isAdmin ? "No paid Human Assistant clients yet." : "No clients are assigned to you yet. Your admin assigns clients from their workspace."}</p>}
      <p data-no-match class="hidden py-8 text-center text-sm text-ink-muted">No clients match.</p>
    </div>
  </section>

  <section class="mt-6 rounded-xl bg-white p-5 shadow-card sm:p-6">
    <h2 class="text-xl font-extrabold">Latest applications</h2>
    <div class="mt-4 divide-y divide-ink/10">{recent.length ? recent.map((row) => { const job = jobs.get(row.job_id); const client = clientById.get(row.user_id); return <div class="flex flex-wrap items-center justify-between gap-3 py-3 text-sm"><span class="min-w-0"><strong class="block truncate">{job?.title || "Unknown role"} · {job?.company}</strong><span class="text-xs text-ink-muted">for <a href={`/admin/clients/${row.user_id}`} class="font-bold text-brand-700">{client?.full_name || client?.email}</a> · by {client?.assistant.name} · {timeAgo(row.submitted_at, now)}</span></span>{job?.external_url && <a href={job.external_url} target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-ink-soft">Job ↗</a>}</div>; }) : <p class="py-4 text-sm text-ink-muted">No applications yet.</p>}</div>
  </section>

  {isAdmin && <div class="mt-6 grid gap-6 lg:grid-cols-2">
    <section class="rounded-xl bg-white p-5 shadow-card sm:p-6">
      <h2 class="text-xl font-extrabold">Leads from the intake form</h2>
      <p class="mt-1 text-sm text-ink-soft">Filled in <code class="rounded bg-surface px-1.5 py-0.5 text-xs">{intakeLink}</code> but not a paying client yet. Their answers appear in their workspace once they pay.</p>
      <div class="mt-4 divide-y divide-ink/10">{leads.length ? leads.map((lead) => <div class="flex flex-wrap justify-between gap-2 py-2.5 text-sm"><span><strong>{lead.full_name}</strong> <span class="text-ink-soft">{lead.email}</span></span><span class="text-xs text-ink-muted">{timeAgo(lead.created_at, now)}</span></div>) : <p class="py-3 text-sm text-ink-muted">No open leads.</p>}</div>
    </section>
    <section class="rounded-xl bg-white p-5 shadow-card sm:p-6">
      <h2 class="text-xl font-extrabold">Access</h2>
      <p class="mt-1 text-sm text-ink-soft">Admins see everything. Agents sign in at <strong>{new URL("/login", Astro.url).host}/login</strong> with the email on their agent card and see only their own clients.</p>
      <p class="mt-4 text-sm"><span class="text-xs font-bold text-ink-muted">ADMINS (ADMIN_EMAILS) </span><br/>{admins.join(", ") || "none"}</p>
      {agentAssignments().size > 0 && <p class="mt-3 text-sm"><span class="text-xs font-bold text-ink-muted">LEGACY AGENT_EMAILS </span><br/>{[...agentAssignments()].map(([email, name]) => `${email} → ${name}`).join(", ")}</p>}
    </section>
  </div>}

  {isAdmin && <section class="mt-6 rounded-xl bg-white p-5 shadow-card sm:p-6">
    <div class="flex flex-wrap items-end justify-between gap-3"><div><h2 class="text-xl font-extrabold">Manage agents</h2><p class="mt-1 text-sm text-ink-soft">The people clients see as their assistant. Add a name, photo and the email they sign in with. Assign clients from each client's workspace.</p></div></div>
    {!managed && <p class="mt-4 rounded-xl bg-human-50 p-4 text-sm font-bold text-human-700">Agents can't be edited yet: run the <code>human_assistants</code> database migration in Supabase first. Until then the five built-in assistants are used.</p>}
    <div class="mt-5 grid gap-4 lg:grid-cols-2">
      {roster.map((assistant) => { const stats = agents.find((agent) => agent.assistant.name === assistant.name); const others = roster.filter((other) => other.id !== assistant.id && other.active !== false); return <article class="rounded-xl border border-ink/10 p-4">
        <div class="flex items-center gap-3"><img src={assistant.avatar} alt="" class="h-12 w-12 flex-none rounded-full object-cover"/><div class="min-w-0 flex-1"><strong class="block truncate">{assistant.name}{assistant.active === false && <span class="ml-2 rounded-full bg-surface px-2 py-0.5 text-xs text-ink-muted">Off</span>}</strong><span class="block truncate text-xs text-ink-muted">{assistant.email || "No login email"} · {stats?.clients ?? 0} client{(stats?.clients ?? 0) === 1 ? "" : "s"}</span></div></div>
        {managed && assistant.id && <details class="mt-3"><summary class="cursor-pointer text-sm font-extrabold text-brand-700">Edit or delete</summary>
          <form data-agent-form class="mt-3 grid gap-3 sm:grid-cols-2"><input type="hidden" name="id" value={assistant.id}/>
            <label class="text-xs font-bold">Name<input name="name" required value={assistant.name} maxlength="80" class="mt-1 block w-full rounded-lg border border-ink/15 px-3 py-2 text-sm"/></label>
            <label class="text-xs font-bold">Login email<input name="email" type="email" value={assistant.email || ""} placeholder="agent@applyscout.app" class="mt-1 block w-full rounded-lg border border-ink/15 px-3 py-2 text-sm"/></label>
            <label class="text-xs font-bold">New photo (optional)<input name="avatar" type="file" accept=".png,.jpg,.jpeg,.webp" class="mt-1 block w-full text-sm"/></label>
            <label class="flex items-center gap-2 self-end text-sm font-bold"><input name="active" type="checkbox" checked={assistant.active !== false}/> Taking new clients</label>
            <div class="sm:col-span-2"><button class="rounded-full bg-ink px-5 py-2.5 text-sm font-extrabold text-white">Save changes</button><p data-error class="mt-2 hidden text-xs font-bold text-red-700" role="alert"></p></div>
          </form>
          <div class="mt-4 rounded-xl bg-red-50 p-3"><p class="text-xs font-bold text-red-800">Delete {assistant.firstName}{(stats?.clients ?? 0) > 0 ? ` and move their ${stats?.clients} client${stats?.clients === 1 ? "" : "s"} to:` : ""}</p>
            <div class="mt-2 flex flex-wrap items-center gap-2">{(stats?.clients ?? 0) > 0 && <select data-reassign class="rounded-lg border border-ink/15 bg-white px-3 py-2 text-sm">{others.map((other) => <option value={other.id}>{other.name}</option>)}</select>}<button type="button" data-delete-agent={assistant.id} class="rounded-full bg-red-700 px-4 py-2 text-xs font-extrabold text-white">Delete agent</button></div>
            <p data-error class="mt-2 hidden text-xs font-bold text-red-800" role="alert"></p>
          </div>
        </details>}
      </article>; })}
    </div>
    {managed && <form data-agent-form class="mt-6 grid gap-3 rounded-xl bg-surface p-4 sm:grid-cols-[1fr_1fr_1fr_auto] sm:items-end">
      <p class="text-sm font-extrabold sm:col-span-4">Add an agent</p>
      <label class="text-xs font-bold">Name<input name="name" required maxlength="80" placeholder="e.g. Tahee Ahmed" class="mt-1 block w-full rounded-lg border border-ink/15 bg-white px-3 py-2 text-sm"/></label>
      <label class="text-xs font-bold">Login email<input name="email" type="email" placeholder="agent@applyscout.app" class="mt-1 block w-full rounded-lg border border-ink/15 bg-white px-3 py-2 text-sm"/></label>
      <label class="text-xs font-bold">Photo<input name="avatar" type="file" accept=".png,.jpg,.jpeg,.webp" class="mt-1 block w-full text-sm"/></label>
      <button class="rounded-full bg-ink px-5 py-2.5 text-sm font-extrabold text-white">Add agent</button>
      <p data-error class="hidden text-xs font-bold text-red-700 sm:col-span-4" role="alert"></p>
    </form>}
  </section>}

  <script is:inline>
    const rows = [...document.querySelectorAll("[data-client-row]")];
    const search = document.querySelector("[data-client-search]");
    const agentFilter = document.querySelector("[data-agent-filter]");
    const attentionOnly = document.querySelector("[data-attention-only]");
    const noMatch = document.querySelector("[data-no-match]");
    function applyFilters() {
      const term = (search?.value || "").trim().toLowerCase();
      const agent = agentFilter?.value || "";
      let shown = 0;
      rows.forEach((row) => {
        const visible = (!term || row.dataset.search.includes(term)) && (!agent || row.dataset.agent === agent) && (!attentionOnly?.checked || row.dataset.attention === "1");
        row.classList.toggle("hidden", !visible);
        if (visible) shown += 1;
      });
      noMatch?.classList.toggle("hidden", shown > 0 || rows.length === 0);
    }
    [search, agentFilter, attentionOnly].forEach((element) => element?.addEventListener("input", applyFilters));
    document.querySelectorAll("[data-agent-form]").forEach((form) => form.addEventListener("submit", async (event) => {
      event.preventDefault();
      const button = form.querySelector("button"), error = form.querySelector("[data-error]"), label = button.textContent;
      button.disabled = true; button.textContent = "Saving…"; error.classList.add("hidden");
      try {
        const response = await fetch("/api/admin/agents", { method: "POST", body: new FormData(form) });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "Could not save the agent");
        location.reload();
      } catch (reason) {
        error.textContent = reason instanceof Error ? reason.message : "Could not save the agent";
        error.classList.remove("hidden"); button.disabled = false; button.textContent = label;
      }
    }));
    document.querySelectorAll("[data-delete-agent]").forEach((button) => button.addEventListener("click", async () => {
      const box = button.closest("div.rounded-xl"), error = box.querySelector("[data-error]");
      if (button.dataset.confirming !== "1") { button.dataset.confirming = "1"; button.textContent = "Click again to delete"; return; }
      button.disabled = true; button.textContent = "Deleting…"; error.classList.add("hidden");
      const reassign = box.querySelector("[data-reassign]")?.value;
      const query = new URLSearchParams({ id: button.dataset.deleteAgent, ...(reassign ? { reassign_to: reassign } : {}) });
      const response = await fetch(`/api/admin/agents?${query}`, { method: "DELETE" });
      if (response.ok) { location.reload(); return; }
      const data = await response.json().catch(() => ({}));
      error.textContent = data.error || "Delete failed"; error.classList.remove("hidden");
      button.disabled = false; button.dataset.confirming = ""; button.textContent = "Delete agent";
    }));
    document.querySelectorAll("[data-agent-row]").forEach((row) => row.addEventListener("click", () => {
      if (!agentFilter) return;
      agentFilter.value = agentFilter.value === row.dataset.agentRow ? "" : row.dataset.agentRow;
      applyFilters();
      agentFilter.scrollIntoView({ behavior: "smooth", block: "center" });
    }));
  </script>
</App>
