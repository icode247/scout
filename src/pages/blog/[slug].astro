---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import { SITE } from "../../config/site";

export const prerender = true;

export async function getStaticPaths() {
  const posts = (await getCollection("blog")).filter((p) => !p.data.draft);
  // Three other posts, closest topic first: same pillar, then shared tags, then newest.
  // Declared here because getStaticPaths cannot see the rest of the frontmatter.
  const relatedTo = (post: (typeof posts)[number]) => {
    const score = (other: (typeof posts)[number]) =>
      (other.data.pillar && other.data.pillar === post.data.pillar ? 10 : 0) + other.data.tags.filter((tag) => post.data.tags.includes(tag)).length;
    return posts
      .filter((other) => other.id !== post.id)
      .sort((x, y) => score(y) - score(x) || y.data.pubDate.getTime() - x.data.pubDate.getTime())
      .slice(0, 3);
  };
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, related: relatedTo(post) } }));
}

const { post, related } = Astro.props;
const { Content } = await render(post);
const d = post.data;
const fmt = (date: Date) => date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: d.title,
  description: d.description,
  datePublished: d.pubDate.toISOString(),
  dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
  author: { "@type": "Organization", name: d.author },
  publisher: { "@type": "Organization", name: SITE.name },
  image: new URL(d.coverImage, SITE.url).href,
  mainEntityOfPage: new URL(`/blog/${post.id}`, SITE.url).href,
  isAccessibleForFree: true,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Blog", item: new URL("/blog", SITE.url).href },
    { "@type": "ListItem", position: 2, name: d.title, item: new URL(`/blog/${post.id}`, SITE.url).href },
  ],
};
---
<Base title={d.title} description={d.description} image={d.coverImage} type="article">
  <Container>
    <article class="mx-auto max-w-prose py-16">
      <nav class="text-sm text-ink-muted"><a href="/blog" class="hover:text-ink">Blog</a> <span aria-hidden="true">/</span> {d.pillar ?? "Article"}</nav>
      <h1 class="mt-3 font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{d.title}</h1>
      <p class="mt-4 text-sm text-ink-muted">
        By {d.author} · Published {fmt(d.pubDate)}{d.updatedDate ? ` · Updated ${fmt(d.updatedDate)}` : ""}
      </p>

      <img
        src={d.coverImage}
        alt={d.coverAlt}
        width="1200"
        height="628"
        fetchpriority="high"
        class="mt-8 aspect-[1200/628] w-full rounded-3xl object-cover shadow-card"
      />

      <div class="prose prose-slate mt-10 max-w-none prose-headings:font-display prose-headings:tracking-tight prose-a:text-brand-700 prose-img:rounded-2xl">
        <Content />
      </div>

      <!-- In-content conversion -->
      <aside class="mt-14 rounded-3xl bg-brand-950 p-8 text-white">
        <h2 class="font-display text-2xl font-bold text-white">Choose how Scout applies for you.</h2>
        <p class="mt-2 max-w-2xl text-brand-100/80">Use a lower-cost AI Assistant or work with a dedicated Human Assistant in WhatsApp. Both services keep a record of the jobs, statuses, and resumes used; Human plans add detailed application evidence.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/pricing" class="rounded-full bg-brand-300 px-5 py-3 text-sm font-extrabold text-ink">Compare plans</a>
          <a href="/how-it-works" class="rounded-full bg-white/10 px-5 py-3 text-sm font-extrabold text-white hover:bg-white/15">See how it works</a>
        </div>
      </aside>

      {d.tags.length > 0 && (
        <div class="mt-10 flex flex-wrap gap-2">
          {d.tags.map((t) => <span class="rounded-full bg-surface-sunken px-3 py-1 text-xs text-ink-soft">{t}</span>)}
        </div>
      )}
    </article>

    {related.length > 0 && (
      <section class="border-t border-black/5 py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="font-display text-3xl font-extrabold tracking-tight">Keep reading</h2>
          <a href="/blog" class="text-sm font-extrabold text-brand-700">All articles →</a>
        </div>
        <div class="mt-8 grid gap-6 md:grid-cols-3">
          {related.map((p) => (
            <a href={`/blog/${p.id}`} class="flex flex-col overflow-hidden rounded-3xl border border-black/5 bg-white shadow-card transition-shadow hover:shadow-lift">
              <img src={p.data.coverImage} alt={p.data.coverAlt} width="1200" height="628" loading="lazy" class="aspect-[1200/628] w-full object-cover" />
              <div class="flex flex-1 flex-col p-7">
                {p.data.pillar && <span class="text-xs font-semibold uppercase tracking-wide text-brand-600">{p.data.pillar}</span>}
                <h3 class="mt-2 text-lg font-bold leading-snug">{p.data.title}</h3>
                <p class="mt-2 flex-1 text-sm text-ink-soft">{p.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </Container>

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>
