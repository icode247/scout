---
import { COUNTRY_ALTERNATES, COUNTRY_PAGES } from "../../data/countries";
import Base from "../../layouts/Base.astro";
import Container from "../../components/Container.astro";
import Button from "../../components/Button.astro";
import FAQ from "../../components/FAQ.astro";
import { SITE } from "../../config/site";

export const prerender = true;
export function getStaticPaths() {
  return COUNTRY_PAGES.map((page) => ({ params: { country: page.slug }, props: { page } }));
}

const { page } = Astro.props;
const pagePath = `/job-application-service/${page.slug}`;
const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `Scout job application service in ${page.name}`,
  serviceType: "Done-for-you job application service",
  provider: { "@id": new URL("/#organization", SITE.url).href },
  areaServed: { "@type": "Country", name: page.name },
  url: new URL(pagePath, SITE.url).href,
  description: page.description,
};
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Job application service", item: new URL("/job-application-service", SITE.url).href },
    { "@type": "ListItem", position: 2, name: page.name, item: new URL(pagePath, SITE.url).href },
  ],
};
---
<Base title={page.title} description={page.description} lang={page.locale} alternates={COUNTRY_ALTERNATES} xDefault="/job-application-service">
  <section class="bg-brand-950 py-20 text-white sm:py-28">
    <Container>
      <nav class="text-sm text-white/60"><a href="/job-application-service" class="hover:text-white">Job application service</a> <span aria-hidden="true">/</span> {page.name}</nav>
      <div class="mt-7 max-w-4xl">
        <p class="font-bold text-brand-300">{page.eyebrow}</p>
        <h1 class="mt-4 font-display text-5xl font-extrabold leading-[.98] tracking-[-.035em] text-white sm:text-7xl">{page.heading}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-white/75">{page.hero}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row"><Button href="/book-call" size="lg" class="rounded-full bg-brand-300 text-ink">Book a human strategy call</Button><Button href="/login?intent=ai" size="lg" variant="ghost" class="rounded-full text-white hover:bg-white/10">Start with AI</Button></div>
      </div>
    </Container>
  </section>

  <section class="bg-white py-20 sm:py-28">
    <Container>
      <div class="grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
        <div><p class="font-bold text-brand-700">The local search brief</p><h2 class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">{page.contextTitle}</h2><p class="mt-5 text-lg leading-relaxed text-ink-soft">{page.context}</p></div>
        <div class="grid gap-4">
          {page.realities.map((item) => <article class="rounded-xl border border-black/5 bg-surface p-6"><h3 class="text-xl font-extrabold">{item.title}</h3><p class="mt-2 leading-relaxed text-ink-soft">{item.body}</p></article>)}
        </div>
      </div>
    </Container>
  </section>

  <section class="bg-surface py-20 sm:py-28">
    <Container>
      <div class="grid items-start gap-12 lg:grid-cols-2">
        <div><p class="font-bold text-brand-700">Set it once</p><h2 class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">What belongs in your {page.adjective} job profile</h2><p class="mt-5 leading-relaxed text-ink-soft">Your assistant works from approved facts and boundaries. When an employer asks something the profile cannot answer safely, the decision should come back to you.</p></div>
        <ul class="grid gap-3 sm:grid-cols-2">
          {page.profileFields.map((field) => <li class="rounded-xl bg-white p-5 font-bold shadow-card"><span class="mr-2 text-brand-700" aria-hidden="true">✓</span>{field}</li>)}
        </ul>
      </div>
    </Container>
  </section>

  <section class="bg-white py-20 sm:py-28">
    <Container>
      <div class="mx-auto max-w-3xl text-center"><p class="font-bold text-brand-700">Choose your lane</p><h2 class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">Human judgement or repeatable AI execution</h2></div>
      <div class="mt-10 grid gap-5 lg:grid-cols-2">
        <article class="rounded-xl bg-brand-950 p-7 text-white sm:p-9"><p class="font-bold text-human-500">Human Assistant</p><h3 class="mt-3 text-2xl font-extrabold text-white">Best when the search needs judgement.</h3><p class="mt-4 leading-relaxed text-white/75">For {page.humanBestFor}. Work with a dedicated assistant in WhatsApp and receive detailed evidence of important form answers.</p><a href="/human-job-application-service" class="mt-6 inline-flex font-extrabold text-brand-300">Explore Human Assistant →</a></article>
        <article class="rounded-xl bg-brand-200 p-7 sm:p-9"><p class="font-bold text-brand-800">AI Assistant</p><h3 class="mt-3 text-2xl font-extrabold">Best when the rules stay stable.</h3><p class="mt-4 leading-relaxed text-ink-soft">For {page.aiBestFor}. See the role, status and {page.documentName} used for each application at a lower recurring price.</p><a href="/ai-job-application-assistant" class="mt-6 inline-flex font-extrabold text-brand-800">Explore AI Assistant →</a></article>
      </div>
    </Container>
  </section>

  <section class="bg-surface py-20 sm:py-28"><Container><div class="mx-auto max-w-3xl"><FAQ items={page.faqs} heading={`Job application help in ${page.name}: questions`} /></div></Container></section>

  <section class="bg-brand-950 py-16 text-white"><Container><div class="mx-auto max-w-3xl text-center"><h2 class="font-display text-4xl font-extrabold text-white">Stop carrying every application yourself.</h2><p class="mt-4 text-lg text-white/72">Compare current Human and AI plans, allowances, evidence, and billing terms in {page.currency === "USD" ? "US dollars" : "USD"}.</p><div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row"><Button href="/pricing" class="bg-brand-300 text-ink">Compare plans</Button><Button href="/book-call" variant="ghost" class="text-white hover:bg-white/10">Book a strategy call</Button></div></div></Container></section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>
