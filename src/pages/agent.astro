---
import App from "../layouts/App.astro";
import LocationMultiSelect from "../components/LocationMultiSelect.astro";
import { loadScoutData } from "../lib/scout-data";
export const prerender = false;
const user = Astro.locals.user!;
if (Astro.locals.scoutProfile?.assistant_type !== "ai") return Astro.redirect("/dashboard");
const data = await loadScoutData(user, Astro.locals.supabase, Astro.locals.demoMode, Astro.locals.scoutProfile);
const profiles = data.jobProfiles.filter((profile) => profile.active);
---
<App title="Scout AI" active="agent">
<div class="mx-auto max-w-6xl">
<header class="flex flex-wrap items-end justify-between gap-5"><div><p class="text-sm font-bold text-signal-700">Scout AI Agent</p><h1 class="mt-1 text-3xl font-extrabold">Tell Scout what a good job looks like.</h1><p class="mt-2 max-w-2xl text-ink-soft">Scout searches and applies through the application service. You do not need the Chrome extension or to add jobs manually.</p></div><a href="/jobs" class="rounded-full bg-white px-5 py-3 text-sm font-extrabold shadow-card">Review matching jobs</a></header>
{profiles.length ? <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1fr)_19rem]"><section class="overflow-hidden rounded-2xl bg-white shadow-card">
<div class="border-b border-ink/10 bg-brand-950 p-5 text-white"><div class="flex items-center gap-3"><span class="grid h-11 w-11 place-items-center rounded-full bg-brand-300 font-extrabold text-brand-950">S</span><div><strong class="text-white">Scout AI</strong><p class="text-xs text-white/60">Application agent</p></div></div></div>
<form id="agent-form" data-profiles={JSON.stringify(profiles)} class="space-y-6 p-5 sm:p-7">
<div class="flex gap-3"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-100 text-xs font-extrabold">AI</span><div class="max-w-xl rounded-2xl rounded-tl-sm bg-surface p-4 text-sm leading-relaxed">Which job profile should I work on? Each profile can have its own roles, locations, and application rules.</div></div>
<label class="ml-11 block text-sm font-bold">Job profile<select name="jobProfileId" id="profile-select" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-4 py-3">{profiles.map(p=><option value={p.id}>{p.name}</option>)}</select></label>
<div id="agent-status" class="ml-11 hidden items-center justify-between gap-4 rounded-xl px-4 py-3"><div class="flex items-center gap-3"><span id="status-dot" class="h-2.5 w-2.5 rounded-full"></span><div><strong id="status-title" class="block text-sm"></strong><span id="status-copy" class="text-xs"></span></div></div><a href="/applications" class="text-xs font-extrabold underline underline-offset-4">View applications</a></div>
<div class="flex gap-3"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-100 text-xs font-extrabold">AI</span><div class="max-w-xl rounded-2xl rounded-tl-sm bg-surface p-4 text-sm">What roles and locations should I search?</div></div>
<div class="ml-11 grid gap-4 sm:grid-cols-2"><label class="text-sm font-bold">Target roles<input required name="roles" placeholder="Java Developer, Backend Developer" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label><LocationMultiSelect/><label class="text-sm font-bold sm:col-span-2">Companies to avoid <span class="font-normal text-ink-muted">(optional)</span><input name="companyBlacklist" placeholder="Acme Corp, Globex" class="mt-2 w-full rounded-xl border border-ink/15 px-4 py-3 font-normal"/></label></div>
<div class="flex gap-3"><span class="grid h-8 w-8 shrink-0 place-items-center rounded-full bg-brand-100 text-xs font-extrabold">AI</span><div class="max-w-xl rounded-2xl rounded-tl-sm bg-surface p-4 text-sm">Now set the guardrails. I will only apply when a job clears them.</div></div>
<div class="ml-11 grid gap-4 sm:grid-cols-3"><label class="text-sm font-bold">Employment<select name="employmentTypes" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-3 py-3 font-normal"><option value="full-time">Full-time</option><option value="part-time">Part-time</option><option value="contractor">Contract</option><option value="">Any</option></select></label><label class="text-sm font-bold">Experience<select name="experienceLevels" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-3 py-3 font-normal"><option value="entry">Entry</option><option value="mid">Mid</option><option value="senior">Senior</option><option value="executive">Executive</option><option value="">Any</option></select></label><label class="text-sm font-bold">Work mode<select name="workModes" class="mt-2 w-full rounded-xl border border-ink/15 bg-white px-3 py-3 font-normal"><option value="remote">Remote</option><option value="hybrid">Hybrid</option><option value="onsite">On-site</option><option value="">Any</option></select></label></div>
<label class="ml-11 block rounded-xl border border-ink/10 p-4"><span class="flex items-center justify-between gap-4 text-sm font-bold"><span>Minimum match score</span><output id="accuracy-output" for="accuracy-threshold">70%</output></span><input id="accuracy-threshold" name="accuracyThreshold" type="range" min="50" max="100" step="5" value="70" class="mt-3 w-full accent-brand-700"/><span class="mt-2 block text-xs font-normal text-ink-muted">Lower the score to see more jobs. Raise it for closer matches.</span></label>
<div class="ml-11 rounded-xl border border-ink/10 p-4"><div class="grid gap-3 sm:grid-cols-2"><label class="flex items-start gap-3 text-sm"><input name="resumePerJob" type="checkbox" class="mt-1 h-4 w-4 accent-brand-700"/><span><strong class="block">Tailor resume per job</strong><span class="text-ink-muted">Generate a targeted resume before applying.</span></span></label><label class="flex items-start gap-3 text-sm"><input name="stealthApply" type="checkbox" class="mt-1 h-4 w-4 accent-brand-700"/><span><strong class="block">Human-paced applications</strong><span class="text-ink-muted">Apply more slowly with natural timing.</span></span></label></div></div>
<div id="agent-message" role="status" aria-live="polite" class="hidden rounded-xl p-4 text-sm font-bold"></div>
<div class="ml-11 flex flex-wrap gap-3"><button id="activate-button" type="submit" data-action="activate" class="rounded-full bg-ink px-6 py-3 text-sm font-extrabold text-white">Activate Scout AI</button><button id="save-button" type="submit" data-action="save" class="rounded-full bg-surface px-6 py-3 text-sm font-extrabold">Save draft</button><button type="submit" data-action="pause" id="pause-button" class="hidden rounded-full px-5 py-3 text-sm font-bold text-red-700">Pause Scout AI</button></div>
</form></section>
<aside class="h-fit rounded-2xl bg-brand-100 p-5"><p class="text-xs font-bold text-brand-800">HOW THIS WORKS</p><ol class="mt-4 space-y-4 text-sm"><li><strong class="block">1. You set the brief</strong><span class="text-ink-soft">One configuration per job profile.</span></li><li><strong class="block">2. Scout finds matches</strong><span class="text-ink-soft">Jobs appear on your Jobs page.</span></li><li><strong class="block">3. Scout applies</strong><span class="text-ink-soft">Automatic and one-click applications are handled securely by Scout.</span></li><li><strong class="block">4. You stay in control</strong><span class="text-ink-soft">Return here to adjust or pause the agent.</span></li></ol></aside></div>
: <div class="mt-8 rounded-2xl bg-white p-10 text-center shadow-card"><h2 class="text-2xl font-extrabold">Create a job profile first</h2><p class="mt-2 text-ink-soft">Scout needs your profile and resume before it can search or apply.</p><a href="/profiles" class="mt-6 inline-block rounded-full bg-ink px-6 py-3 text-sm font-extrabold text-white">Create job profile</a></div>}
</div></App>
<script>
// @ts-nocheck
const form=document.querySelector("#agent-form"),select=document.querySelector("#profile-select"),message=document.querySelector("#agent-message"),pause=document.querySelector("#pause-button"),activate=document.querySelector("#activate-button"),save=document.querySelector("#save-button"),statusBox=document.querySelector("#agent-status"),statusDot=document.querySelector("#status-dot"),statusTitle=document.querySelector("#status-title"),statusCopy=document.querySelector("#status-copy"),locationPicker=document.querySelector("[data-location-picker]"),accuracy=document.querySelector("#accuracy-threshold"),accuracyOutput=document.querySelector("#accuracy-output");
let configs=[];const profiles=form?JSON.parse(form.dataset.profiles||"[]"):[],platforms=["greenhouse","lever","ashby","workable","recruitee","workday","smartrecruiters"];
const split=value=>String(value||"").split(",").map(item=>item.trim()).filter(Boolean);
function show(text,error=false){message.textContent=text;message.className="rounded-xl p-4 text-sm font-bold "+(error?"bg-red-50 text-red-800":"bg-signal-50 text-signal-800")}
function renderStatus(config){const active=config?.status==="active"&&config?.first_apply_id,paused=config?.status==="paused";statusBox.classList.remove("hidden","bg-signal-50","text-signal-800","bg-surface","text-ink-soft");statusBox.classList.add("flex",active?"bg-signal-50":"bg-surface",active?"text-signal-800":"text-ink-soft");statusDot.className="h-2.5 w-2.5 rounded-full "+(active?"bg-signal-600":paused?"bg-amber-500":"bg-ink-muted");statusTitle.textContent=active?"Scout AI is running":paused?"Scout AI is paused":"Scout AI is not active";statusCopy.textContent=active?"Searching and applying with this profile.":paused?"No automatic applications are being started.":"Activate Scout when these rules are ready.";activate.textContent=active?"Update Scout AI":paused?"Resume Scout AI":"Activate Scout AI";save.textContent=paused?"Save changes":"Save draft";save.classList.toggle("hidden",Boolean(active));pause.classList.toggle("hidden",!active)}
function fill(){const config=configs.find(item=>item.job_profile_id===select.value),profile=profiles.find(item=>item.id===select.value);form.elements.roles.value=(config?.roles||profile?.target_roles||[]).join(", ");locationPicker?.dispatchEvent(new CustomEvent("scout:set-locations",{detail:config?.locations||profile?.locations||[]}));form.elements.companyBlacklist.value=(config?.company_blacklist||[]).join(", ");form.elements.employmentTypes.value=config?(config.employment_types?.[0]||""):"full-time";form.elements.experienceLevels.value=config?(config.experience_levels?.[0]||""):"entry";form.elements.workModes.value=config?(config.work_modes?.[0]||""):"remote";form.elements.resumePerJob.checked=Boolean(config?.resume_per_job);form.elements.stealthApply.checked=Boolean(config?.stealth_apply);accuracy.value=String(config?.accuracy_threshold??70);accuracyOutput.textContent=accuracy.value+"%";renderStatus(config)}
if(form){accuracy.addEventListener("input",()=>accuracyOutput.textContent=accuracy.value+"%");fetch("/api/app/ai-agent").then(async response=>{const data=await response.json();if(!response.ok)throw new Error(data.error);configs=data.configs||[];fill()}).catch(()=>show("I could not load your saved settings.",true));select.addEventListener("change",()=>{message.classList.add("hidden");fill()});form.addEventListener("submit",async event=>{event.preventDefault();const button=event.submitter,action=button?.dataset.action||"save",fd=new FormData(form),locations=fd.getAll("locations");if(action!=="pause"&&!locations.length){show("Choose at least one country, city, or Remote.",true);locationPicker?.querySelector("[data-location-search]")?.focus();return}button.disabled=true;show(action==="activate"?"Connecting your profile and starting Scout AI…":action==="pause"?"Pausing Scout AI…":"Saving your rules…");try{const response=await fetch("/api/app/ai-agent",{method:"POST",headers:{"content-type":"application/json"},body:JSON.stringify({action,jobProfileId:fd.get("jobProfileId"),roles:split(fd.get("roles")),locations,companyBlacklist:split(fd.get("companyBlacklist")),employmentTypes:split(fd.get("employmentTypes")),experienceLevels:split(fd.get("experienceLevels")),workModes:split(fd.get("workModes")),platforms,datePosted:"7d",maxApplicationsPerDay:10,scheduleType:"daily",scheduleTime:"09:00",accuracyThreshold:Number(fd.get("accuracyThreshold")||70),resumePerJob:fd.get("resumePerJob")==="on",stealthApply:fd.get("stealthApply")==="on"})});const data=await response.json();if(!response.ok)throw new Error(data.error||"Unable to update Scout AI");configs=configs.filter(item=>item.job_profile_id!==data.config.job_profile_id).concat(data.config);show(action==="activate"?"Scout AI is running with these rules.":action==="pause"?"Scout AI is paused.":"Rules saved.");fill()}catch(error){show(error.message||"Unable to update Scout AI",true)}finally{button.disabled=false}})}
</script>