---
import Base from "../layouts/Base.astro";
import Container from "../components/Container.astro";
import Button from "../components/Button.astro";
import FAQ from "../components/FAQ.astro";
import ProductScreenshot from "../components/ProductScreenshot.astro";
import HumanPlanFeatures from "../components/marketing/HumanPlanFeatures.astro";
import UsdPlanTable from "../components/marketing/UsdPlanTable.astro";
import { SITE } from "../config/site";
import { approvedServiceLd } from "../config/offer-catalog";
import { COUNTRY_PAGES } from "../data/countries";

const proofAnswer = "Ask what proof you will get before you pay. With Scout you see every job, its status and the resume used, and Human Assistant plans also include screenshots or records of important form answers.";
const salaryAnswer = "No. The price of your plan is the only fee. There is no placement fee and no percentage of your salary.";

const faqs = [
  { q: "Can I pay someone to apply to jobs for me?", a: "Yes. Scout assigns a Human Assistant who applies on your behalf, or you can choose a lower-cost AI Assistant. You set the roles, locations, salary preferences, exclusions, and resume rules before applications begin." },
  { q: "Is Scout a reverse recruiting service?", a: "Scout provides the application-operations part of reverse recruiting: finding suitable roles, preparing tailored materials, submitting applications, and tracking the work. Scout does not claim to represent employers or guarantee interviews or job offers." },
  { q: "What is the difference between the Human and AI assistants?", a: "Human Assistant members work with a dedicated person in WhatsApp and receive detailed evidence of important application answers. AI Assistant members pay less and see the job, status, and resume used, but do not receive form-answer screenshots." },
  { q: "Can I choose which jobs Scout applies to?", a: "Yes. Create multiple job profiles, add jobs from the dashboard or Chrome extension, choose the profile to use, and control whether Scout tailors a resume or uses your original." },
  { q: "Does Scout tailor every resume?", a: "Scout can tailor a copy of your resume to the job description while preserving your original. You can also tell your assistant to use a specific resume without tailoring." },
  { q: "Is a job application service worth it?", a: "It is worth considering when time is your bottleneck: you work full time, you are tired of repeating the same forms, and your target roles are clear. It is a weaker fit when the real problem is an unclear target role or a resume that is not working. Fix those first, or pair a service with a coach. Read [is a job application service worth it?](/blog/is-a-job-application-service-worth-it) for five measures and a worked example." },
  { q: "What does a job application service cost?", a: "At Scout, AI Assistant plans are $39 a month for 75 applications and $79 for 200. Human Assistant plans are $299 a month for 250 applications, $499 for 500 and $999 for 1,000. All prices are in US dollars. Prepaying 90 days costs about 10% less. There is no placement fee. Our price guide shows what other providers publish, with the date we read each one." },
  { q: "How do I know a service actually submitted my applications?", a: proofAnswer },
  { q: "Do you take a percentage of my salary?", a: salaryAnswer },
  { q: "How do I start?", a: "Create an account, choose Human or AI, and import your resume. Your dashboard opens with your profile saved. Activate a plan from your dashboard to begin." },
  { q: "How does a job application service work?", a: "You set target roles and rules, then the service finds matching openings, prepares your materials, submits the applications and records each one. You keep interviews and the decisions that matter. Ask what proof you will get of each submission before you pay." },
  { q: "What is the difference between a job application service, auto-apply and a reverse recruiter?", a: "A job application service may use a person, software or both to find matching roles, prepare materials, submit applications and record the work. Auto-apply usually means software submits forms for you. A reverse recruiter usually adds positioning and outreach to hiring managers. Scout provides the application-operations part and does not claim to represent employers." },
  { q: "What does a job application service not do?", a: "It does not interview for you, choose your career or decide who gets hired. It should not invent experience. It is application labor, not a recruiter pitching you to a hiring manager." },
];
const serviceLd = approvedServiceLd();
const breadcrumbLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Scout", item: SITE.url },
    { "@type": "ListItem", position: 2, name: "Job application service", item: new URL("/job-application-service", SITE.url).href },
  ],
};
---
<Base title="Job Application Service That Applies for You" description="Too busy or exhausted to apply? Scout's Human and AI job application assistants find roles, tailor resumes, apply on your behalf, and track every submission.">
  <section class="bg-brand-950 py-20 text-white sm:py-28">
    <Container>
      <div class="grid items-center gap-12 lg:grid-cols-[.86fr_1.14fr]">
        <div>
          <p class="text-lg font-bold text-brand-300">Done-for-you job applications</p>
          <h1 class="mt-4 font-display text-5xl font-extrabold leading-[.98] tracking-[-.035em] text-white sm:text-7xl">A job application service that applies for you.</h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-white/75">If work, family, or application fatigue has taken over your search, Scout can run the repetitive work. Choose a dedicated Human Assistant or a lower-cost AI Assistant.</p>
          <p class="mt-4 max-w-xl text-lg leading-relaxed text-white/75">Plans start at $39 a month for the AI Assistant and $299 a month for a dedicated Human Assistant. <a href="#plans" class="font-extrabold text-brand-300 underline underline-offset-2">See every price</a>.</p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row"><Button href="/pricing#human" size="lg" class="rounded-full bg-brand-300 text-ink">Get my assistant</Button><Button href="/book-call" size="lg" variant="ghost" class="rounded-full text-white hover:bg-white/10">Book a free call</Button><Button href="/login?intent=ai" size="lg" variant="ghost" class="rounded-full text-white/70 hover:bg-white/10">Start with AI</Button></div>
        </div>
        <ProductScreenshot variant="queue" />
      </div>
    </Container>
  </section>

  <section class="bg-white py-20 sm:py-28">
    <Container>
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-4xl font-extrabold sm:text-6xl">What is a job application service?</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">A job application service is a paid service that finds matching openings, prepares your materials, submits applications on your behalf and records each one. You set the roles and rules; a person, software or both complete the forms. No service can promise interviews or offers, because employers make those decisions.</p>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">ApplyScout (Scout, at applyscout.app) is a job application service with two versions: a dedicated Human Assistant from $299 a month for 250 applications, and a lower-cost AI Assistant from $39 a month for 75 applications.</p>
        <h3 class="mt-10 font-display text-2xl font-extrabold">What should a job application service include?</h3>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[560px] border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-ink/10">
                <th class="p-3 font-extrabold">Part of the job</th>
                <th class="p-3 font-extrabold">What to expect from a good service</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">Find jobs</td><td class="p-3">Openings matched to the roles, locations, salary range and exclusions you set</td></tr>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">Prepare</td><td class="p-3">Resume and cover notes adjusted to each posting, based on your real experience</td></tr>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">Submit</td><td class="p-3">Applications completed on your behalf, with unclear questions raised with you</td></tr>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">Record</td><td class="p-3">The job, status, resume used and, ideally, evidence of important form answers</td></tr>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">Terms</td><td class="p-3">A clear monthly or prepaid price, cancellation terms, and no hidden salary percentage</td></tr>
            </tbody>
          </table>
        </div>
        <h3 class="mt-10 font-display text-2xl font-extrabold">How does a job application service work?</h3>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">The work runs in four steps:</p>
        <ol class="mt-4 list-decimal space-y-3 pl-5 text-lg leading-relaxed text-ink-soft">
          <li><strong class="text-ink">Set your criteria.</strong> You share a resume and the roles, locations, salary range and exclusions you want the service to follow.</li>
          <li><strong class="text-ink">Find and filter openings.</strong> The service looks for matching jobs and drops ones that break your rules.</li>
          <li><strong class="text-ink">Prepare materials.</strong> It uses your approved experience to tailor a resume or cover note to the posting. Tailoring means rewording what is true, not adding skills you do not have.</li>
          <li><strong class="text-ink">Submit and record.</strong> It completes the form, sends the application and logs the job, status and materials used, so you can inspect the work. A good service pauses and asks you when a form question cannot be answered from your approved facts.</li>
        </ol>
        <p class="mt-6 text-lg leading-relaxed text-ink-soft">At Scout, that flow is: you <a href="/how-it-works" class="font-extrabold text-brand-700">set the search once</a>, your Human or AI Assistant applies, and you inspect every job, status and resume used. Human Assistant plans also include screenshots of important form answers. For the longer guide, see <a href="/blog/what-is-a-job-application-service" class="font-extrabold text-brand-700">what a job application service is</a>.</p>
        <h3 class="mt-10 font-display text-2xl font-extrabold">Types of job application help</h3>
        <div class="mt-6 overflow-x-auto">
          <table class="w-full min-w-[560px] border-collapse text-left text-sm">
            <thead>
              <tr class="border-b border-ink/10">
                <th class="p-3 font-extrabold">Type</th>
                <th class="p-3 font-extrabold">Who does the work</th>
                <th class="p-3 font-extrabold">What it is for</th>
              </tr>
            </thead>
            <tbody>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">Human application service</td><td class="p-3">A dedicated person</td><td class="p-3">Handing off form work when your target roles are clear, with someone you can ask about unclear questions</td></tr>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">AI or automated assistant</td><td class="p-3">Software</td><td class="p-3">Lower-cost, repeatable searches with a record of each job</td></tr>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">Reverse recruiter</td><td class="p-3">A recruiter, who may add outreach</td><td class="p-3">A wider campaign that may add positioning and outreach to hiring managers</td></tr>
              <tr class="border-b border-ink/10"><td class="p-3 font-bold">Career coach</td><td class="p-3">A coach</td><td class="p-3">Interview practice, strategy and negotiation, not submitting applications for you</td></tr>
            </tbody>
          </table>
        </div>
        <p class="mt-6 text-lg leading-relaxed text-ink-soft">A service takes over the work you lack time for. It does not replace a clear target role or a resume that says what you want it to say.</p>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">If the bottleneck is labor, not strategy, you can use Scout's <a href="/ai-job-application-assistant" class="font-extrabold text-brand-700">AI Assistant</a> from $39 a month for 75 applications, or a <a href="/human-job-application-service" class="font-extrabold text-brand-700">Human Assistant</a> from $299 a month for 250. Scout does not guarantee interviews. See <a href="/pricing" class="font-extrabold text-brand-700">pricing</a>.</p>
      </div>
      <div class="mx-auto mt-20 max-w-3xl text-center"><h2 class="font-display text-4xl font-extrabold sm:text-6xl">You keep the decisions. We handle the forms.</h2><p class="mt-5 text-lg leading-relaxed text-ink-soft">Scout is built for people who are too busy to apply consistently, have already tried doing it alone, or are exhausted by repeating the same information across job sites.</p></div>
      <div class="mt-12 grid gap-5 lg:grid-cols-3">
        <article class="rounded-xl bg-surface p-6"><h3 class="text-xl font-extrabold">Set the search once</h3><p class="mt-3 leading-relaxed text-ink-soft">Choose target roles, locations, salary range, dealbreakers, sponsorship needs, and resume preferences.</p></article>
        <article class="rounded-xl bg-brand-200 p-6"><h3 class="text-xl font-extrabold">Applications keep moving</h3><p class="mt-3 leading-relaxed text-ink-soft">Your assistant finds matching openings, prepares the right materials, and completes applications on your behalf.</p></article>
        <article class="rounded-xl bg-human-50 p-6"><h3 class="text-xl font-extrabold">Inspect the completed work</h3><p class="mt-3 leading-relaxed text-ink-soft">See every job, status, profile, and resume used. Human plans also include evidence of important form answers.</p></article>
      </div>
    </Container>
  </section>

  <section class="bg-surface py-20 sm:py-28">
    <Container>
      <div class="grid gap-6 lg:grid-cols-2">
        <article class="rounded-xl bg-brand-950 p-7 text-white sm:p-9">
          <p class="font-bold text-human-500">Human job application service</p>
          <h2 class="mt-3 font-display text-4xl font-extrabold text-white">Hire a person to apply on your behalf.</h2>
          <p class="mt-5 leading-relaxed text-white/72">Scout learns your targets, assigns an assistant, and opens a dedicated WhatsApp group. Your assistant handles nuance and saves detailed evidence.</p>
          <ul class="mt-6 space-y-3 text-sm font-semibold text-white/75"><li>✓ Dedicated Human Assistant</li><li>✓ WhatsApp communication</li><li>✓ Multiple job profiles</li><li>✓ Resume and answer evidence</li></ul>
          <p class="mt-6 text-sm font-extrabold text-white">Human plans: $299, $499 or $999 a month.</p>
          <a href="/human-job-application-service" class="mt-7 inline-flex font-extrabold text-brand-300">Explore Human Assistant service →</a>
        </article>
        <article class="rounded-xl bg-brand-200 p-7 sm:p-9">
          <p class="font-bold text-brand-800">AI job application assistant</p>
          <h2 class="mt-3 font-display text-4xl font-extrabold">Start immediately at a lower monthly price.</h2>
          <p class="mt-5 leading-relaxed text-ink-soft">Create an account, upload your resume, review the data Scout extracts, and open your prepared dashboard. The AI Assistant applies and records the job, status, and resume used.</p>
          <ul class="mt-6 space-y-3 text-sm font-semibold text-ink-soft"><li>✓ Guided resume import</li><li>✓ Tailored application materials</li><li>✓ Safe application pacing</li><li>✓ Visible submission tracker</li></ul>
          <p class="mt-6 text-sm font-extrabold text-ink">AI plans: $39 or $79 a month.</p>
          <a href="/ai-job-application-assistant" class="mt-7 inline-flex font-extrabold text-brand-800">Explore AI Assistant service →</a>
        </article>
      </div>
    </Container>
  </section>

  <section id="plans" class="bg-white py-20 sm:py-28">
    <Container>
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-4xl font-extrabold sm:text-5xl">What does a job application service cost at Scout?</h2>
        <p class="mt-5 text-lg leading-relaxed text-ink-soft">All prices are in US dollars. Each plan is a monthly subscription, and you can prepay 90 days for about 10% less. There is no placement fee.</p>
      </div>
      <UsdPlanTable />
      <p class="mx-auto max-w-3xl text-lg leading-relaxed text-ink-soft">Cost per application is the monthly price divided by the monthly allowance, at full use. It is our arithmetic, not a measure of results.</p>
      <HumanPlanFeatures variant="service-table" />
      <div class="mx-auto max-w-3xl text-lg leading-relaxed text-ink-soft">
        <p>Scout does not guarantee interviews or offers. Employers decide who they interview and hire.</p>
        <p>To start, create your account, import your resume and activate a plan from your dashboard. No call is required.</p>
        <p>See <a href="/how-it-works" class="font-extrabold text-brand-700">how Scout works</a> and <a href="/safety" class="font-extrabold text-brand-700">application safety</a>, compare every feature on the <a href="/pricing" class="font-extrabold text-brand-700">pricing page</a>, or read <a href="/blog/job-application-service-cost" class="font-extrabold text-brand-700">how much a job application service costs</a>. The plans are also described on the <a href="/human-job-application-service" class="font-extrabold text-brand-700">Human Assistant</a> and <a href="/ai-job-application-assistant" class="font-extrabold text-brand-700">AI Assistant</a> pages.</p>
      </div>
    </Container>
  </section>

  <section class="bg-surface py-20 sm:py-28">
    <Container>
      <div class="grid items-start gap-12 lg:grid-cols-[.75fr_1.25fr]">
        <div><h2 class="font-display text-4xl font-extrabold sm:text-6xl">What “apply for me” actually includes.</h2><p class="mt-5 text-lg leading-relaxed text-ink-soft">The service covers the application workflow, not just autofilling a few fields.</p></div>
        <ol class="divide-y divide-ink/10 border-y border-ink/10">
          <li class="grid gap-3 py-6 sm:grid-cols-[2rem_1fr]"><strong>1</strong><div><h3 class="font-extrabold">Create job profiles</h3><p class="mt-1 text-ink-soft">Separate searches for different roles, locations, and resume strategies.</p></div></li>
          <li class="grid gap-3 py-6 sm:grid-cols-[2rem_1fr]"><strong>2</strong><div><h3 class="font-extrabold">Find or add suitable jobs</h3><p class="mt-1 text-ink-soft">Use Scout's match queue or send any opening from the dashboard and Chrome extension.</p></div></li>
          <li class="grid gap-3 py-6 sm:grid-cols-[2rem_1fr]"><strong>3</strong><div><h3 class="font-extrabold">Prepare and submit</h3><p class="mt-1 text-ink-soft">Use the approved resume behavior, answer known questions, and escalate uncertainty.</p></div></li>
          <li class="grid gap-3 py-6 sm:grid-cols-[2rem_1fr]"><strong>4</strong><div><h3 class="font-extrabold">Track every application</h3><p class="mt-1 text-ink-soft">Review the role, company, submission status, resume used, and available evidence.</p></div></li>
        </ol>
      </div>
      <nav class="mt-12 flex flex-wrap gap-x-7 gap-y-3 text-sm font-extrabold" aria-label="Related job application guides"><a href="/how-it-works" class="text-brand-700">How Scout works →</a><a href="/pricing" class="text-brand-700">Compare pricing →</a><a href="/safety" class="text-brand-700">Application safety →</a><a href="/auto-apply" class="text-brand-700">Supported job sites →</a><a href="/blog/best-job-application-services-2026" class="text-brand-700">Best application services →</a><a href="/blog/job-application-service-cost" class="text-brand-700">Service cost guide →</a></nav>
    </Container>
  </section>

  <section class="bg-white py-16 sm:py-20">
    <Container>
      <div class="mx-auto max-w-3xl">
        <h2 class="font-display text-3xl font-extrabold sm:text-4xl">How to start</h2>
        <ol class="mt-6 list-decimal space-y-3 pl-5 text-lg leading-relaxed text-ink-soft">
          <li>Open your dashboard at <a href="https://applyscout.app" class="font-extrabold text-brand-700">https://applyscout.app</a>. Create an account, choose Human or AI, and import your resume. No call is required to start.</li>
          <li>Check that your target roles, locations and dealbreakers say what you actually want.</li>
          <li>Activate a plan from your dashboard. Your dashboard opens with your profile saved. Activate a plan there to begin.</li>
          <li>Start your first applications and follow each one in your tracker, with the resume used for each.</li>
        </ol>
      </div>
    </Container>
  </section>

  <section class="bg-brand-50 py-20 sm:py-24">
    <Container>
      <div class="max-w-3xl"><p class="font-bold text-brand-700">Country guides</p><h2 class="mt-3 font-display text-4xl font-extrabold sm:text-5xl">Job application help for the market you are targeting.</h2><p class="mt-4 text-lg text-ink-soft">Local terminology, work eligibility, salary conventions, and location rules change how a delegated search should run.</p></div>
      <nav class="mt-9 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" aria-label="Job application service by country">
        {COUNTRY_PAGES.map((country) => <a href={`/job-application-service/${country.slug}`} class="rounded-xl bg-white p-5 font-extrabold shadow-card transition hover:-translate-y-0.5 hover:shadow-lift">{country.name} <span class="text-brand-700" aria-hidden="true">→</span></a>)}
      </nav>
    </Container>
  </section>

  <section class="bg-surface py-20 sm:py-28"><Container><div class="mx-auto max-w-3xl"><FAQ items={faqs} /></div></Container></section>

  <script type="application/ld+json" set:html={JSON.stringify(serviceLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />
</Base>
