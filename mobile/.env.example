# Public client values only. Never put a Supabase service-role key here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
EXPO_PUBLIC_API_URL=https://applyscout.app

# Keep disabled in production. This only exposes the local fixture preview button.
EXPO_PUBLIC_ENABLE_DEMO=false
